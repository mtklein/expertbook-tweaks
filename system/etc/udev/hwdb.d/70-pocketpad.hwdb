# PocketPad (github.com/Dathaze20/PocketPad), an Android app that makes a
# phone/handheld (here a Retroid Pocket Nova) a Bluetooth HID gamepad.
# It declares 16 anonymous buttons, so hid-generic names them in order
# (BTN_SOUTH, BTN_EAST, BTN_C, BTN_NORTH, ...) and SDL's automatic mapping,
# which Steam and native games use, puts X/Y, bumpers, Select/Start and the
# stick clicks on the wrong functions. Rename them to the standard codes.
# Scancodes are HID usages (Button page 0x09). Apply:
#   sudo systemd-hwdb update && sudo udevadm trigger -s input
evdev:input:b0005v001Dp1200*
 KEYBOARD_KEY_90001=btn_south
 KEYBOARD_KEY_90002=btn_east
 KEYBOARD_KEY_90003=btn_x
 KEYBOARD_KEY_90004=btn_y
 KEYBOARD_KEY_90005=btn_tl
 KEYBOARD_KEY_90006=btn_tr
 KEYBOARD_KEY_90007=btn_tl2
 KEYBOARD_KEY_90008=btn_tr2
 KEYBOARD_KEY_90009=btn_select
 KEYBOARD_KEY_9000a=btn_start
 KEYBOARD_KEY_9000b=btn_thumbl
 KEYBOARD_KEY_9000c=btn_thumbr
 KEYBOARD_KEY_9000d=btn_mode
 KEYBOARD_KEY_9000e=btn_trigger_happy1
 KEYBOARD_KEY_9000f=btn_trigger_happy2
 KEYBOARD_KEY_90010=btn_trigger_happy3
