#!/bin/bash
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dest="$HOME/.config/omarchy/plugins"
stamps="${XDG_STATE_HOME:-$HOME/.local/state}/plugin-patches"
owner="${USER:-$(id -un)}"

usage() {
  echo "usage: sync apply            rebuild every clone from stock Omarchy plus its patch" >&2
  echo "       sync record <name>... turn the installed clone's edits back into its patch" >&2
  exit 2
}

stock() {
  local id="omarchy.$1" out="$2" dir manifest source target
  IFS=$'\t' read -r dir manifest < <(omarchy-plugin-catalog |
    jq -r --arg id "$id" '.[] | select(.firstParty and .id == $id) | [.sourceDir, .manifestPath] | @tsv')
  [[ -n ${dir:-} ]] || { echo "sync: no stock plugin $id" >&2; return 1; }
  if [[ ${manifest##*/} == manifest.json ]]; then
    cp -aL "$dir/." "$out/"
  else
    cp -aL "$manifest" "$out/manifest.json"
    while IFS=$'\t' read -r source target; do
      mkdir -p "$(dirname "$out/$target")"
      cp -aL "$dir/$source" "$out/$target"
    done < <(jq -r '[(.entryPoints[] | [., .]), (.omarchy.clonePaths[]? | [.source, .target])] | unique[] | @tsv' "$manifest")
  fi
  jq --arg id "$owner.$1" --arg from "$id" '
    .id = $id | .name = "My " + .name |
    if (.barWidget | type) == "object" then .barWidget.displayName = .name else . end |
    .omarchy = ((.omarchy // {}) + {clonedFrom: $from}) | del(.omarchy.clonePaths)
  ' "$out/manifest.json" >"$out/manifest.json.tmp" && mv "$out/manifest.json.tmp" "$out/manifest.json"
}

tree_hash() {
  (cd "$1" && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1)
}

apply() {
  local failed=0 changed=0 patch name id tmp
  mkdir -p "$dest" "$stamps"
  for patch in "$here"/*.patch; do
    name=$(basename "$patch" .patch)
    id="$owner.$name"
    if [[ -d $dest/$id && -f $stamps/$id && $(tree_hash "$dest/$id") != $(<"$stamps/$id") ]]; then
      echo "sync: $id has edits that aren't in its patch; run: plugins/sync record $name" >&2
      failed=1
      continue
    fi
    tmp=$(mktemp -d "$dest/.sync.XXXXXX")
    if stock "$name" "$tmp" && patch -d "$tmp" -p1 -s -N --no-backup-if-mismatch <"$patch"; then
      if [[ -d $dest/$id && ! -L $dest/$id && $(tree_hash "$tmp") == $(tree_hash "$dest/$id") ]]; then
        rm -rf "$tmp"
      else
        rm -rf "$dest/$id"
        mv "$tmp" "$dest/$id"
        chmod 755 "$dest/$id"
        changed=1
        echo "sync: rebuilt $id"
      fi
      tree_hash "$dest/$id" >"$stamps/$id"
    else
      rm -rf "$tmp"
      echo "sync: $name.patch no longer applies to stock omarchy.$name; $id left as it was" >&2
      failed=1
    fi
  done
  (( changed )) && omarchy restart shell >/dev/null 2>&1
  return $failed
}

record() {
  local name id tmp
  mkdir -p "$stamps"
  for name in "$@"; do
    id="$owner.$name"
    [[ -d $dest/$id ]] || { echo "sync: no clone $dest/$id" >&2; return 1; }
    tmp=$(mktemp -d)
    mkdir "$tmp/a"
    stock "$name" "$tmp/a" || { rm -rf "$tmp"; return 1; }
    ln -s "$dest/$id" "$tmp/b"
    (cd "$tmp" && diff -ruN -x LICENSE.omarchy a b) | sed -E '/^(---|\+\+\+) /s/\t.*//; /^diff -ruN/d' >"$here/$name.patch"
    rm -rf "$tmp"
    tree_hash "$dest/$id" >"$stamps/$id"
    echo "sync: recorded $name.patch"
  done
}

case ${1:-} in
  apply) apply ;;
  record) shift; (( $# > 0 )) || usage; record "$@" ;;
  *) usage ;;
esac
