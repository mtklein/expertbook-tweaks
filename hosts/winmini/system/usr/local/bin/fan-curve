#!/usr/bin/python3
import glob
import signal
import sys
import time

CURVE = [(40, 32), (50, 90), (55, 135), (58, 175), (60, 208), (65, 255)]
PERIOD = 2
COOLING_RATE = 0.15


def hwmon(name):
    for path in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            if open(path + "/name").read().strip() == name:
                return path
        except OSError:
            pass
    sys.exit(f"no {name} sensor")


def wanted(temp):
    if temp <= CURVE[0][0]:
        return CURVE[0][1]
    for (t0, p0), (t1, p1) in zip(CURVE, CURVE[1:]):
        if temp <= t1:
            return round(p0 + (p1 - p0) * (temp - t0) / (t1 - t0))
    return CURVE[-1][1]


def main():
    chip = hwmon("k10temp") + "/temp1_input"
    fan = hwmon("gpdfan")

    def write(name, value):
        with open(f"{fan}/{name}", "w") as f:
            f.write(str(value))

    def automatic(*_):
        write("pwm1_enable", 2)
        sys.exit(0)

    signal.signal(signal.SIGTERM, automatic)
    signal.signal(signal.SIGINT, automatic)
    write("pwm1_enable", 1)
    felt = None
    last = None
    try:
        while True:
            temp = int(open(chip).read()) / 1000
            if felt is None or temp > felt:
                felt = temp
            else:
                felt += (temp - felt) * COOLING_RATE
            pwm = wanted(felt)
            if pwm != last:
                write("pwm1", pwm)
                last = pwm
            time.sleep(PERIOD)
    finally:
        write("pwm1_enable", 2)


if __name__ == "__main__":
    main()
