#!/usr/bin/python3
import ctypes, syslog, time

c_ulong, c_long, c_int, c_void_p = ctypes.c_ulong, ctypes.c_long, ctypes.c_int, ctypes.c_void_p
X = ctypes.CDLL("libX11.so.6")
X.XOpenDisplay.restype = c_void_p
X.XOpenDisplay.argtypes = [ctypes.c_char_p]
X.XDefaultRootWindow.restype = c_ulong
X.XDefaultRootWindow.argtypes = [c_void_p]
X.XInternAtom.restype = c_ulong
X.XInternAtom.argtypes = [c_void_p, ctypes.c_char_p, c_int]
X.XGetInputFocus.argtypes = [c_void_p, ctypes.POINTER(c_ulong), ctypes.POINTER(c_int)]
X.XSetInputFocus.argtypes = [c_void_p, c_ulong, c_int, c_ulong]
X.XFlush.argtypes = [c_void_p]
X.XFree.argtypes = [c_void_p]
X.XGetWindowProperty.argtypes = [
    c_void_p, c_ulong, c_ulong, c_long, c_long, c_int, c_ulong,
    ctypes.POINTER(c_ulong), ctypes.POINTER(c_int), ctypes.POINTER(c_ulong),
    ctypes.POINTER(c_ulong), ctypes.POINTER(ctypes.POINTER(c_ulong)),
]
HANDLER = ctypes.CFUNCTYPE(c_int, c_void_p, c_void_p)
ignore = HANDLER(lambda display, error: 0)
X.XSetErrorHandler.argtypes = [HANDLER]

display = X.XOpenDisplay(None)
if not display:
    raise SystemExit(0)
X.XSetErrorHandler(ignore)
root = X.XDefaultRootWindow(display)


def prop(window, name):
    kind, fmt, count, left = c_ulong(), c_int(), c_ulong(), c_ulong()
    data = ctypes.POINTER(c_ulong)()
    atom = X.XInternAtom(display, name, 0)
    status = X.XGetWindowProperty(display, window, atom, 0, 1, 0, 0, kind, fmt, count, left, data)
    if status != 0 or not data:
        return 0
    value = data[0] if count.value and fmt.value == 32 else 0
    X.XFree(data)
    return value


def focus():
    window, revert = c_ulong(), c_int()
    X.XGetInputFocus(display, window, revert)
    return window.value


for wait in (0.4, 0.8):
    time.sleep(wait)
    active = prop(root, b"_NET_ACTIVE_WINDOW")
    holder = focus()
    if not active or holder in (0, 1, active):
        continue
    owner, thief = prop(active, b"_NET_WM_PID"), prop(holder, b"_NET_WM_PID")
    if owner and thief and owner != thief:
        X.XSetInputFocus(display, active, 1, 0)
        X.XFlush(display)
        syslog.syslog("x-focus-heal: focus was on %#x (pid %d), returned to active window %#x (pid %d)" % (holder, thief, active, owner))
