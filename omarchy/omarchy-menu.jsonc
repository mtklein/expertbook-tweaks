{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},

  // Night light at 3300 K (real kelvin): the stock rows run omarchy-toggle-nightlight, which
  // hard-codes 4000 K. Route them through the shell's night light service
  // instead, whose clone (~/expertbook-tweaks/omarchy-plugins/mtklein.nightlight)
  // uses 3300 K. Overrides don't inherit the stock rows' icon/label/when here,
  // so they're repeated in full.
  "trigger.toggle.nightlight-on": {"icon":"󰔎","label":"Nightlight On","when":"[[ $(omarchy-shell nightlight status) != *'\"enabled\":true'* ]]","action":"omarchy-shell nightlight enable"},
  "trigger.toggle.nightlight-off": {"icon":"󰔎","label":"Nightlight Off","when":"[[ $(omarchy-shell nightlight status) == *'\"enabled\":true'* ]]","action":"omarchy-shell nightlight disable"},

  // Bar Items: widgets that are off the bar most of the time, one row each.
  // Choosing a row puts it on the bar (with the status icons on the right) or
  // takes it off again; a tick marks the ones that are on. ~/.local/bin/bar-item.
  "appearance.top-bar.items": {"icon":"󰍜","label":"Bar Items","description":"Show or hide optional bar widgets"},
  "appearance.top-bar.items.display": {"icon":"󰍹","label":"Display","checked":"$HOME/.local/bin/bar-item on mtklein.monitor","action":"$HOME/.local/bin/bar-item toggle mtklein.monitor"},
  "appearance.top-bar.items.audio": {"icon":"󰕾","label":"Audio","checked":"$HOME/.local/bin/bar-item on mtklein.audio","action":"$HOME/.local/bin/bar-item toggle mtklein.audio"},
  "appearance.top-bar.items.microphone": {"icon":"󰍬","label":"Microphone","checked":"$HOME/.local/bin/bar-item on omarchy.microphone","action":"$HOME/.local/bin/bar-item toggle omarchy.microphone"},
  "appearance.top-bar.items.media": {"icon":"󰎇","label":"Media","checked":"$HOME/.local/bin/bar-item on omarchy.media","action":"$HOME/.local/bin/bar-item toggle omarchy.media"},
  "appearance.top-bar.items.agents": {"icon":"󰚩","label":"Agents","checked":"$HOME/.local/bin/bar-item on mtklein.agents","action":"$HOME/.local/bin/bar-item toggle mtklein.agents"},
  "appearance.top-bar.items.world-clock": {"icon":"󰥔","label":"World Clock","checked":"$HOME/.local/bin/bar-item on omarchy.elsewhen","action":"$HOME/.local/bin/bar-item toggle omarchy.elsewhen"},
  "appearance.top-bar.items.tailscale": {"icon":"󰖂","label":"Tailscale","checked":"$HOME/.local/bin/bar-item on mtklein.tailscale","action":"$HOME/.local/bin/bar-item toggle mtklein.tailscale"},
  "appearance.top-bar.items.dropbox": {"icon":"󰇣","label":"Dropbox","checked":"$HOME/.local/bin/bar-item on mtklein.dropbox","action":"$HOME/.local/bin/bar-item toggle mtklein.dropbox"},
  "appearance.top-bar.items.menu-button": {"icon":"󰍜","label":"Omarchy Menu Button","checked":"$HOME/.local/bin/bar-item on omarchy.menu","action":"$HOME/.local/bin/bar-item toggle omarchy.menu"},
}
