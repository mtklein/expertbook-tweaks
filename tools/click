#!/usr/bin/env python3
import fcntl, os, struct, sys, time
W, H = 1600, 1000
EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
BTN_LEFT, ABS_X, ABS_Y = 0x110, 0, 1
def ioc(d, t, n, s): return (d << 30) | (s << 16) | (ord(t) << 8) | n
UI_SET_EVBIT = ioc(1, 'U', 100, 4); UI_SET_KEYBIT = ioc(1, 'U', 101, 4); UI_SET_ABSBIT = ioc(1, 'U', 103, 4); UI_SET_PROPBIT = ioc(1, 'U', 110, 4)
UI_DEV_SETUP = ioc(1, 'U', 3, 92); UI_ABS_SETUP = ioc(1, 'U', 4, 28)
UI_DEV_CREATE = ioc(0, 'U', 1, 0); UI_DEV_DESTROY = ioc(0, 'U', 2, 0)
fd = os.open('/dev/uinput', os.O_WRONLY)
for e in (EV_KEY, EV_ABS): fcntl.ioctl(fd, UI_SET_EVBIT, e)
fcntl.ioctl(fd, UI_SET_KEYBIT, BTN_LEFT)
fcntl.ioctl(fd, UI_SET_PROPBIT, 0)
for a, m in ((ABS_X, W), (ABS_Y, H)):
    fcntl.ioctl(fd, UI_SET_ABSBIT, a)
    fcntl.ioctl(fd, UI_ABS_SETUP, struct.pack('HHiiiiii', a, 0, 0, 0, m, 0, 0, 0))
fcntl.ioctl(fd, UI_DEV_SETUP, struct.pack('HHHH80sI', 3, 0x1234, 0x5678, 1, b'test-pointer', 0))
fcntl.ioctl(fd, UI_DEV_CREATE)
time.sleep(0.8)
def ev(t, c, v): os.write(fd, struct.pack('llHHi', 0, 0, t, c, v))
def move(x, y): ev(EV_ABS, ABS_X, x); ev(EV_ABS, ABS_Y, y); ev(EV_SYN, 0, 0)
def click(x, y):
    move(x, y); time.sleep(0.08); ev(EV_KEY, BTN_LEFT, 1); ev(EV_SYN, 0, 0); time.sleep(0.05); ev(EV_KEY, BTN_LEFT, 0); ev(EV_SYN, 0, 0)
for step in sys.argv[1:]:
    if step.startswith('sleep'): time.sleep(float(step[5:]))
    elif step.startswith('m'): x, y = map(int, step[1:].split(',')); move(x, y)
    else: x, y = map(int, step.split(',')); click(x, y)
time.sleep(0.2)
fcntl.ioctl(fd, UI_DEV_DESTROY)
