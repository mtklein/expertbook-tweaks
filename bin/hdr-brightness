#!/bin/bash
# Brightness that also works in HDR mode.
#
# With HDR on, the internal OLED ignores its backlight, so brightness is applied
# in Hyprland by scaling eDP-1's SDR white level (edp_hdr_monitor() in
# hypr/hdr.lua). The level (0-1) is saved to ~/.local/state/hdr-brightness,
# which is also where the current level is read from.
# Anything else (HDR off, another monitor, on/off) is handed to
# omarchy-brightness-display unchanged.
#
# Used by the brightness keys (~/.config/hypr/bindings.lua) and the bar's
# Display panel (~/.config/omarchy/plugins/*.monitor and hdr-monitor-state).
#
# Usage: hdr-brightness [--no-osd] [--monitor NAME] [+5% | 5%- | +1% | 1%- | N%]
#        With no step, prints the current brightness percent.

no_osd=0
monitor=""
while (( $# > 0 )); do
  case $1 in
    --no-osd) no_osd=1; shift ;;
    --monitor) monitor="$2"; shift 2 ;;
    *) break ;;
  esac
done
step="$1"

passthrough() {
  local args=()
  (( no_osd )) && args+=(--no-osd)
  [[ -n $monitor ]] && args+=(--monitor "$monitor")
  [[ -n $step ]] && args+=("$step")
  exec omarchy-brightness-display "${args[@]}"
}

[[ -z $step || $step =~ ^(\+?[0-9]+%|[0-9]+%-)$ ]] || passthrough

[[ -n $monitor ]] || monitor="$(omarchy-hyprland-monitor-focused 2>/dev/null)"
[[ $monitor == eDP-1 ]] || passthrough

hdr=$(hyprctl monitors -j | jq -r '.[] | select(.name == "eDP-1" and .colorManagementPreset == "hdr") | .name')
[[ -n $hdr ]] || passthrough

state="${XDG_STATE_HOME:-$HOME/.local/state}"
current=$(cat "$state/hdr-brightness" 2>/dev/null || echo 1.00)

current=$(awk -v b="$current" 'BEGIN { printf "%d", b * 100 + 0.5 }')
if [[ -z $step ]]; then
  echo "$current"
  exit 0
fi

exec {lock_fd}>"${XDG_RUNTIME_DIR:-/tmp}/hdr-brightness.lock"
flock -n "$lock_fd" || exit 0

n=${step//[^0-9]/}
# 5% steps snap to the 5% grid (51 -> 55 up, 56 -> 55 down), since automatic
# brightness leaves the level anywhere; at the dim end (0-5%) they move by 1.
# Other step sizes (Alt's 1%) move by exactly that much.
case $step in
  +*) if (( n == 5 )); then
        if (( current < 5 )); then target=$(( current + 1 )); else target=$(( current / 5 * 5 + 5 )); fi
      else target=$(( current + n )); fi ;;
  *-) if (( n == 5 )); then
        if (( current <= 5 )); then target=$(( current - 1 )); else target=$(( (current + 4) / 5 * 5 - 5 )); fi
      else target=$(( current - n )); fi ;;
  *)  target=$n ;;
esac
(( target > 100 )) && target=100
(( target < 0 )) && target=0

value=$(awk -v t="$target" 'BEGIN { printf "%.2f", t / 100 }')
hyprctl eval "edp_hdr_monitor($value)" >/dev/null

mkdir -p "$state" && echo "$value" > "$state/hdr-brightness"

(( no_osd )) || omarchy-osd -i brightness -p "$target"
