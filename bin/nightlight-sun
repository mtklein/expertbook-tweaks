#!/bin/bash
# Point hyprsunset's night light at today's real sunset and sunrise.
#
# Rewrites ~/.config/hypr/hyprsunset.conf with two profiles (sunrise: no tint,
# sunset: NIGHT_TEMP) and restarts hyprsunset when the times changed, since
# hyprsunset reads its config only at startup. hyprsunset re-checks the wall
# clock every minute, so it catches up by itself after suspend.
#
# Location: the same as Omarchy's weather widget — the coordinates or name set
# with `omarchy weather location --set`, otherwise wttr.in's IP lookup.
# Offline or a bad reply leaves the existing config alone.
#
# Run daily and at login by systemd-user/nightlight-sun.timer.
set -euo pipefail

NIGHT_TEMP=${NIGHT_TEMP:-4000}
CONF="$HOME/.config/hypr/hyprsunset.conf"
LOC_FILE="$HOME/.local/state/omarchy/settings/weather.json"

query=""
if [[ -f $LOC_FILE ]]; then
  query=$(jq -r '
    if (.latitude|type) == "number" and (.longitude|type) == "number"
    then "\(.latitude),\(.longitude)"
    else (.name // "" | gsub(" "; "+")) end' "$LOC_FILE" 2>/dev/null || true)
fi

reply=""
for attempt in 1 2 3 4 5; do
  reply=$(curl -fsS --max-time 10 "https://wttr.in/${query}?format=%l|%S|%s" 2>/dev/null) && break
  reply=""
  ((attempt < 5)) && sleep $((attempt * 10))
done

IFS='|' read -r place sunrise sunset <<<"$reply"
time_re='^[0-9]{2}:[0-9]{2}'
if [[ ! $sunrise =~ $time_re || ! $sunset =~ $time_re ]]; then
  echo "nightlight-sun: no usable sunrise/sunset (reply: '${reply}'); keeping $CONF" >&2
  exit 0
fi
sunrise=${sunrise:0:5}
sunset=${sunset:0:5}

new=$(cat <<EOF
# Written by ~/expertbook-tweaks/bin/nightlight-sun — edits here are overwritten.
# ${place}: sunrise ${sunrise}, sunset ${sunset} (updated $(date +%F))
profile {
    time = ${sunrise}
    identity = true
}

profile {
    time = ${sunset}
    temperature = ${NIGHT_TEMP}
}
EOF
)

# Compare without the "updated" date so an unchanged day doesn't restart.
strip() { grep -v '^# ' <<<"$1"; }
if [[ -f $CONF ]] && [[ "$(strip "$new")" == "$(strip "$(cat "$CONF")")" ]]; then
  echo "nightlight-sun: ${place}: ${sunrise}–${sunset} unchanged"
  exit 0
fi

printf '%s\n' "$new" >"$CONF.tmp" && mv "$CONF.tmp" "$CONF"
echo "nightlight-sun: ${place}: night light ${sunset}–${sunrise} at ${NIGHT_TEMP}K"

# Restart hyprsunset. Wait for the old one to exit first: a new instance that
# starts while the old one still holds the compositor's CTM manager exits at
# once ("A CTM manager is already running"), which omarchy-restart-app's
# kill-then-launch can hit. Launch through Hyprland (Lua dispatch) so it lands
# in its own uwsm app scope rather than in this short-lived service's cgroup.
if hyprctl -j version >/dev/null 2>&1; then
  pkill -x hyprsunset || true
  for _ in $(seq 50); do pgrep -x hyprsunset >/dev/null || break; sleep 0.1; done
  hyprctl dispatch 'hl.dsp.exec_cmd("uwsm-app -- hyprsunset")' >/dev/null
fi
