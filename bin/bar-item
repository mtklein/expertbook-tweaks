#!/bin/bash
# Put an optional widget on the Omarchy bar, or take it off. For the
# Appearance > Menu Bar > Bar Items rows (omarchy/omarchy-menu.jsonc).
#
#   bar-item on <id>       succeeds if the widget is on the bar (for the row's tick)
#   bar-item toggle <id>   on -> off, off -> on
#
# Turned on, a widget goes in with the status icons on the right (before
# Bluetooth, or at the end of the right section if that isn't there).
# Turning off one of our clones (mtklein.monitor) makes Omarchy put the stock
# widget it replaced (omarchy.monitor) back in its place, so that goes too.
set -uo pipefail
conf="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
on_bar() { jq -e --arg id "$1" '[.bar.layout[]?[]?.id] | index($id) != null' "$conf" >/dev/null 2>&1; }

cmd=${1:-} id=${2:-}
[[ -n $id ]] || { echo "usage: bar-item on|toggle <widget id>" >&2; exit 2; }
case $cmd in
  on) on_bar "$id" ;;
  toggle)
    if on_bar "$id"; then
      omarchy plugin disable "$id" >/dev/null
      stock="omarchy.${id#*.}"
      [[ $stock != "$id" ]] && on_bar "$stock" && omarchy plugin disable "$stock" >/dev/null
    elif on_bar mtklein.bluetooth; then
      omarchy plugin enable "$id" --before mtklein.bluetooth >/dev/null
    else
      omarchy plugin enable "$id" --section right >/dev/null
    fi ;;
  *) echo "usage: bar-item on|toggle <widget id>" >&2; exit 2 ;;
esac
