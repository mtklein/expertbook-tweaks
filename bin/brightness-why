#!/usr/bin/python3
"""Why is the screen this bright? Prints ambient-display's view of brightness:
the room light, who owns the level, what the learned model suggests, and the
evidence that shaped it near the current light level.

Usage: brightness-why [--all]   (--all: every piece of evidence)
"""
import json
import math
import os
import sys
import time
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "ambient-display.json"
STATUS = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "ambient-display-status.json"


def lux(x):
    return 10 ** x - 1


try:
    st = json.loads(STATUS.read_text())
except (OSError, ValueError):
    sys.exit("no status yet: is ambient-display running? (systemctl --user status ambient-display)")
try:
    events = json.loads(STATE.read_text()).get("brightness_events", [])
except (OSError, ValueError):
    events = []

white = st.get("white") or 500
print(f"at {st['time']}: room {st['lux']:.0f} lux, {st['hour']:.1f} h; screen {st['level']}%"
      f" ({st.get('nits') or 0:.0f} nits of {white:.0f})")
if st["owner"] == "user":
    if st["level"] is not None and st["level"] < 10:
        print("  yours: below 10%, so automatic brightness leaves it alone until you change it")
    else:
        print(f"  yours since you set it at {st['hold_lux']} lux; automatic resumes once the room"
              f" is ~2x brighter or dimmer than that, or after 3 h")
else:
    off = f", carrying your {st['offset_nits']:+.0f} nits" if abs(st["offset_nits"]) >= 1 else ""
    print(f"  automatic: model says {st['model_nits']:.0f} nits here{off} -> target {st['target']}%")
if st.get("open"):
    o = st["open"]
    print(f"  your current choice ({o['nits']:.0f} nits) becomes evidence once you change it again"
          f" or the room changes; kept {time.time() - o['t']:.0f} s so far")

x = math.log10(st["lux"] + 1)
now = time.time()
show = events if "--all" in sys.argv else [e for e in events if abs(e["x"] - x) <= 0.4]
print(f"\nevidence{' (all)' if '--all' in sys.argv else ' near this light level'}:"
      f" {len(show)} of {len(events)}")
for e in sorted(show, key=lambda e: e["t"])[-25:]:
    age = (now - e["t"]) / 86400
    h = "any time" if e.get("h") is None else f"{e['h']:4.1f} h"
    print(f"  {e['k']:8} {lux(e['x']):7.0f} lux  {h:>8}  {e['nits']:5.0f} nits"
          f"  kept {e['d'] / 60:6.1f} min  {age:5.1f} d ago")
