#!/bin/bash
# Run a game with the MangoHud overlay if, and only if, there is black space
# to put it in.
#
# As a Steam launch option:
#
#     letterbox-hud %command%
#     letterbox-hud -r 60 -- %command%              (anything before -- goes to gamescope)
#     letterbox-hud --aspect 21:9 -- %command%      (the game's picture shape; default 16:9)
#
# It looks at the screen the game is about to open on (the focused one). If the
# game's picture, fitted to that screen's width, leaves a band of at least
# MIN_BAND pixels above and below (16:9 on this laptop's 16:10 panel: 90 px),
# the game runs inside gamescope at exactly that picture size with the HUD
# (mangoapp, ~/.config/MangoHud/MangoHud.conf) in the top band. Otherwise (a
# 16:9 TV, where the picture fills the screen) the game runs on its own, with
# nothing drawn over it.
#
# LETTERBOX_HUD_DRY=1 prints what it would run instead of running it.
MIN_BAND=40

aspect=16:9
gamescope_args=()
# No "--" at all: everything is the game's command ("letterbox-hud %command%").
has_sep=0
for a in "$@"; do [[ $a == -- ]] && has_sep=1; done
while (( has_sep && $# > 0 )); do
  case $1 in
    --) shift; break ;;
    --aspect) aspect=$2; shift 2 ;;
    *) gamescope_args+=("$1"); shift ;;
  esac
done
(( $# > 0 )) || { echo "usage: letterbox-hud [--aspect W:H] [gamescope options] -- command..." >&2; exit 1; }

run() {
  if [[ -n ${LETTERBOX_HUD_DRY:-} ]]; then printf '%q ' "$@"; echo; exit 0; fi
  exec "$@"
}

# The focused screen, in real pixels. LETTERBOX_HUD_SCREEN=WxH overrides it (for testing).
if [[ ${LETTERBOX_HUD_SCREEN:-} =~ ^([0-9]+)x([0-9]+)$ ]]; then
  W=${BASH_REMATCH[1]} H=${BASH_REMATCH[2]}
else
  read -r W H < <(hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.focused) | "\(.width) \(.height)"')
fi
[[ $W =~ ^[0-9]+$ && $H =~ ^[0-9]+$ && $aspect =~ ^([0-9]+):([0-9]+)$ ]] || run "$@"
aw=${BASH_REMATCH[1]} ah=${BASH_REMATCH[2]}
(( aw > 0 && ah > 0 )) || run "$@"

h=$(( W * ah / aw / 2 * 2 ))          # the picture's height at full width, kept even
band=$(( (H - h) / 2 ))
if (( band >= MIN_BAND )) && command -v gamescope >/dev/null; then
  run gamescope "${gamescope_args[@]}" -W "$W" -H "$H" -w "$W" -h "$h" -f --mangoapp -- "$@"
fi
run "$@"
