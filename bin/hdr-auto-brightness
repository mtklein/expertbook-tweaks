#!/usr/bin/python3
"""Ambient-light screen brightness for the internal OLED, wluma/macOS style.

Reads the iio "als" sensor and drives brightness through hdr-brightness (so it
works in HDR, where the panel ignores its backlight, and keeps the keys, bar
slider and border dimming consistent).

Learning (like wluma): every manual adjustment becomes a (lux, nits) point,
where nits is the SDR white level Hyprland is actually using (so the curve
survives changes to edp_sdr_white in hypr/hdr.lua, i.e. what "100%" means). Brightness is interpolated between points on a log-lux scale. A new
point replaces nearby ones and evicts any that would make the curve
non-monotonic, so brighter rooms never mean a dimmer screen.

Motion (like macOS): lux is smoothed (faster when the room brightens than when
it darkens), small differences are ignored, and changes fade in 1% steps.

Manual changes are detected when the brightness differs from what this daemon
last set; it then pauses, and learns the new level once it's been left alone
for SETTLE seconds.

Floor: automatic changes never go below MIN_PCT (5%). Anything below that
(including 0, "screen off") is manual-only: while the screen sits there the
daemon keeps its hands off and learns nothing, and the next change back to
MIN_PCT or above is learned as usual. brightness-wake-floor raises a dimmed
screen to the same 5% on wake from suspend.

Brightness is still set through hdr-brightness as a percent of edp_sdr_white,
which hdr.lua publishes to ~/.local/state/hdr-sdr-white.

State: ~/.local/state/hdr-auto-brightness.json (delete it to forget learning).

Cost: the once-a-second check reads Hyprland's socket and the hdr-brightness
state file directly; spawning hyprctl + hdr-brightness (+ jq, awk) for it cost
~3% of a core. Subprocesses are only used to set brightness.
"""
import json
import math
import os
import socket
import subprocess
import time
from pathlib import Path

SENSOR = None  # resolved at startup
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
STATE = STATE_DIR / "hdr-auto-brightness.json"
WHITE = STATE_DIR / "hdr-sdr-white"
LEVEL = STATE_DIR / "hdr-brightness"     # written by hdr-brightness
MONITOR = "eDP-1"

DEFAULT_POINTS = [  # (lux, nits); replaced by learning over time
    (0, 40), (5, 60), (30, 90), (120, 130), (400, 200), (1500, 300),
]
TICK = 0.2              # seconds between loop iterations
TAU_UP = 1.5            # lux smoothing time constant when brightening (s)
TAU_DOWN = 6.0          # ... when darkening (s)
DEADBAND = 3            # ignore target differences smaller than this (%)
STEP_EVERY_UP = 0.08    # seconds per 1% step while fading up
STEP_EVERY_DOWN = 0.2   # ... while fading down
SETTLE = 4.0            # seconds a manual change must be left alone to be learned
NEAR = 0.25             # log10-lux distance within which a new point replaces old ones
MIN_PCT, MAX_PCT = 5, 100   # below MIN_PCT is manual-only (never set or learned)


def find_sensor():
    for d in Path("/sys/bus/iio/devices").glob("iio:device*"):
        try:
            if (d / "name").read_text().strip() == "als":
                return d
        except OSError:
            pass
    return None


def sensor_attr(name, default):
    try:
        return float((SENSOR / name).read_text())
    except (OSError, ValueError):
        return default


def read_lux():
    # Blocks ~0.75 s in the ISH driver (asleep, not on CPU), which paces the loop.
    raw = float((SENSOR / "in_illuminance_raw").read_text())
    return max(0.0, (raw + LUX_OFFSET) * LUX_SCALE)


def L(lux):
    return math.log10(lux + 1.0)


def load_points():
    try:
        pts = json.loads(STATE.read_text())["nits"]
        return sorted((float(a), float(b)) for a, b in pts)
    except (OSError, ValueError, KeyError, TypeError):
        return [(float(a), float(b)) for a, b in DEFAULT_POINTS]


def save_points(points):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps({"nits": [[round(a, 1), round(b)] for a, b in points]}, indent=1) + "\n")
    tmp.replace(STATE)


def predict(points, lux):
    x = L(lux)
    xs = [(L(a), b) for a, b in points]
    if x <= xs[0][0]:
        return xs[0][1]
    if x >= xs[-1][0]:
        return xs[-1][1]
    for (x0, y0), (x1, y1) in zip(xs, xs[1:]):
        if x0 <= x <= x1:
            return y0 + (y1 - y0) * (x - x0) / (x1 - x0) if x1 > x0 else y1
    return xs[-1][1]


def learn(points, lux, nits):
    x = L(lux)
    kept = []
    for a, b in points:
        xa = L(a)
        if abs(xa - x) < NEAR:
            continue                    # replaced by the new point
        if (xa < x and b > nits) or (xa > x and b < nits):
            continue                    # would make the curve non-monotonic
        kept.append((a, b))
    kept.append((lux, float(nits)))
    return sorted(kept)


def hypr_socket():
    run = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if sig:
        return f"{run}/hypr/{sig}/.socket.sock"
    socks = sorted(Path(run, "hypr").glob("*/.socket.sock"), key=lambda p: p.stat().st_mtime)
    return str(socks[-1]) if socks else None


def hypr_json(command):
    """Like `hyprctl -j <command>`, without spawning hyprctl."""
    path = hypr_socket()
    if not path:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(3)
            s.connect(path)
            s.sendall(f"j/{command}".encode())
            data = b""
            while chunk := s.recv(65536):
                data += chunk
        return json.loads(data)
    except (OSError, ValueError):
        return None


def edp_state():
    """eDP-1's (sdr white nits, hdr?) now, or None if the screen is off/missing."""
    m = next((m for m in hypr_json("monitors") or [] if m.get("name") == MONITOR), None)
    if not (m and not m.get("disabled") and m.get("dpmsStatus", True)):
        return None
    return m.get("sdrMaxLuminance"), m.get("colorManagementPreset") == "hdr"


def sdr_white(nits, pct):
    """Nits at 100%: published by hdr.lua, else inferred from the current level."""
    try:
        return float(WHITE.read_text())
    except (OSError, ValueError):
        return nits * 100 / pct if nits and pct else 200.0


def get_pct(hdr):
    """Current brightness percent, as `hdr-brightness` would print it."""
    if hdr:  # hdr-brightness's own state file; reading it is what the script does
        try:
            return int(float(LEVEL.read_text()) * 100 + 0.5)
        except OSError:
            return 100
        except ValueError:
            return None
    out = subprocess.run(["hdr-brightness", "--monitor", MONITOR], capture_output=True, text=True, timeout=5)
    try:
        return int(out.stdout.strip())
    except ValueError:
        return None


def set_pct(pct):
    subprocess.run(["hdr-brightness", "--no-osd", "--monitor", MONITOR, f"{pct}%"],
                   capture_output=True, timeout=5)


def main():
    global SENSOR, LUX_SCALE, LUX_OFFSET
    SENSOR = find_sensor()
    if SENSOR is None:
        raise SystemExit("no iio 'als' sensor found")
    LUX_SCALE = sensor_attr("in_illuminance_scale", 1.0)
    LUX_OFFSET = sensor_attr("in_illuminance_offset", 0.0)

    points = load_points()
    smooth = L(read_lux())
    last_set = None          # what we last wrote; None until first sync
    manual_since = None      # time of the most recent manual change still settling
    next_step = 0.0
    last_check = 0.0
    fading = False           # once a fade starts, finish it even inside the deadband
    white = None             # nits at 100%, refreshed with each brightness poll

    while True:
        now = time.monotonic()
        try:
            lux = read_lux()
        except (OSError, ValueError):
            time.sleep(1)
            continue
        x = L(lux)
        tau = TAU_UP if x > smooth else TAU_DOWN
        smooth += (x - smooth) * (1 - math.exp(-TICK / tau))
        smooth_lux = 10 ** smooth - 1

        # Brightness polling (spawns hyprctl) at ~1 Hz is plenty.
        if now - last_check >= 1.0 or manual_since is not None:
            last_check = now
            state = edp_state()
            nits = state[0] if state else None
            current = get_pct(state[1]) if nits else None
            if current is None:
                time.sleep(1)
                continue
            white = sdr_white(nits, current)
            if current < MIN_PCT:            # user dimmed below the floor: hands off,
                last_set = current           # and don't learn it as a preference
                manual_since = None
                time.sleep(1)
                continue
            if last_set is None:
                last_set = current
            if current != last_set:          # someone else changed it
                manual_since = now
                last_set = current
            if manual_since is not None:
                if now - manual_since >= SETTLE:
                    points = learn(points, smooth_lux, nits)
                    save_points(points)
                    print(f"learned {smooth_lux:.0f} lux -> {nits:g} nits ({current}% of {white:g})", flush=True)
                    manual_since = None
                    fading = False
                time.sleep(TICK)
                continue

        if last_set is not None and white and now >= next_step:
            target = int(round(min(MAX_PCT, max(MIN_PCT, 100 * predict(points, smooth_lux) / white))))
            diff = target - last_set
            if abs(diff) >= DEADBAND or (fading and diff != 0):
                fading = True
                step = 1 if diff > 0 else -1
                last_set += step
                set_pct(last_set)
                next_step = now + (STEP_EVERY_UP if step > 0 else STEP_EVERY_DOWN)
            else:
                fading = False

        time.sleep(TICK)


if __name__ == "__main__":
    main()
