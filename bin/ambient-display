#!/usr/bin/python3
"""Ambient-light screen brightness and white point for the internal OLED.

One daemon, one light sensor reader, two controllers that work the same way:
a model predicts the setting from the sensors, the screen glides toward it
calmly, and manual changes (brightness keys, Shift + brightness keys for the
white point) are learned as corrections at the room's light level.

Sensor (iio "als", Intel ISH): every sysfs read blocks ~1 s (a synchronous HID
request), so a background thread reads lux every cycle and colour temperature
every COLOR_EVERY cycles (~1 Hz lux, ~1/3 Hz colour); the control loop never
waits on it, and all smoothing uses the samples' real timestamps.

Brightness (through hdr-brightness, so it works in HDR, where the panel ignores
its backlight): learned from evidence, not a curve edited in place.
  evidence: each manual choice (room light, time of day, nits, how long it was
         kept) and "silent approvals" (an automatic level left untouched for
         APPROVE_EVERY), kept MAX_AGE, in ~/.local/state/ambient-display.json.
  fit:   per time of day, kernel-weighted robust medians over a log-lux grid
         (weights: closeness in lux and in time of day on the 24 h circle, how
         long the level was kept, recency), made non-decreasing in lux by
         isotonic regression. One odd moment can't erase what was learned.
  who:   hdr-brightness stamps SOURCE on every user change (keys, bar slider);
         this daemon writes with --auto. A user change owns the level until
         the room's light moves HOLD_DECADES (~2x) or HOLD_MAX passes; then
         automatic control resumes from there, easing out the user's offset.
  floor: never auto-sets below MIN_PCT (5%); a user level below that is left
         alone indefinitely and never learned. SIGUSR1 (brightness-wake-floor)
         hands the current level back to automatic control without learning it.
  move:  lux smoothed TAU_UP / TAU_DOWN, DEADBAND %, 1% steps; status for
         `brightness-why` in $XDG_RUNTIME_DIR/ambient-display-status.json.

White point (through hyprsunset's IPC, 100 K resolution):
  model: lit room (sensor measures colour) -> partway (ADAPT, in mireds) toward
         the room's colour, clamped to NEUTRAL..LIT_WARMEST (6600..5000 K).
         Dark room (the sensor's fixed "can't measure" 4500 K reading for
         DARK_AFTER s; colour is lost somewhere around 7-37 lux) -> it still
         measures lux, so fade (linear in log lux) from the last lit value at
         the lux where colour was lost to NIGHT_K (4500 K) at NIGHT_LUX.
  learn: from evidence, like brightness. `white-point` (the Shift + brightness
         keys) sets hyprsunset itself and writes the value to MANUAL_WHITE. The
         choice then owns the screen until the room's light moves HOLD_DECADES,
         HOLD_MAX passes, the room turns dark <-> lit or the night light toggle
         is used; then it's kept as an event (log lux, nightness, the mired
         difference from the model, how long it was kept). Automatic white left
         untouched on screen for APPROVE_EVERY is a silent approval (weight
         APPROVE_WEIGHT). The correction at the current lux and nightness is the
         weighted median of the events (closeness in log lux and nightness, dwell,
         recency), shrunk toward the plain model by WHITE_PRIOR, so a brief odd
         choice (or a burst of them, e.g. keys pressed while hyprsunset wasn't
         running) can't decide it. Nightness follows the sun's elevation (0 above
         +6 deg, 1 below -6 deg, i.e. through civil twilight). Location: wttr.in's
         IP lookup, once, cached in the state file (no network: the clock
         decides, 07:00-18:00 day). First run seeds the evidence from every
         white point choice still in the journal.
  move:  colour smoothed over TAU s, lux over TAU_LUX s. The screen holds
         still until the target is HOLD_K away (so sensor wobble never shows),
         then glides all the way there at most RATE mired/s in STEP_K steps
         (hyprsunset takes any kelvin; 20 K steps are invisible where 100 K
         ones read as a series of jumps), and holds again.
  night light toggle (omarchy-plugins/mtklein.nightlight) writes "night" or
         "day" to OVERRIDE; honoured until the room changes dark <-> lit or a
         manual white point change.
  6600 K is neutral: hyprsunset's curve is ~identity there (1, 1, 0.99) but,
  unlike `identity`, it reports a temperature matching the screen. The value
  is re-sent every RESEND s (hyprsunset re-applies its profile daily).

State: ~/.local/state/ambient-display.json (brightness and white point
evidence, dark-fade start, location; "white_offsets" is the old point table,
no longer used). Bad moments are left in the evidence: the fit is meant to
shrug them off, so a model that can't is the thing to fix.
Migrates hdr-auto-brightness.json / ambient-white.json on first run.
"""
import json
import math
import os
import re
import signal
import socket
import subprocess
import threading
import time
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
STATE = STATE_DIR / "ambient-display.json"
OLD_BRIGHTNESS = STATE_DIR / "hdr-auto-brightness.json"
OLD_WHITE = STATE_DIR / "ambient-white.json"
WHITE = STATE_DIR / "hdr-sdr-white"            # nits at 100%, from hdr.lua
LEVEL = STATE_DIR / "hdr-brightness"           # current level, from hdr-brightness
MANUAL_WHITE = STATE_DIR / "white-point.manual"  # kelvin, from white-point
OVERRIDE = STATE_DIR / "ambient-white.override"  # "night" | "day", from the bar toggle
MONITOR = "eDP-1"

TICK = 0.2               # control loop period (s)
SETTLE = 4.0             # seconds a manual white point change must be left alone to be learned
COLOR_EVERY = 3          # sensor cycles per colour read (the rest read lux)

# Brightness
SOURCE = STATE_DIR / "hdr-brightness.source"   # "user <epoch> <pct>", from hdr-brightness (not --auto)
STATUS = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "ambient-display-status.json"
TV_MODE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "tv-mode/active"  # from tv-mode
DEFAULT_POINTS = [(0, 40), (5, 60), (30, 90), (120, 130), (400, 200), (1500, 300)]
TAU_UP = 7.5             # lux smoothing when the room brightens (s)
TAU_DOWN = 30.0          # ... when it darkens
DEADBAND = 3             # ignore target differences smaller than this (%)
STEP_EVERY_UP = 0.7      # seconds per 1% step while fading up
STEP_EVERY_DOWN = 1.0    # ... while fading down
MIN_PCT, MAX_PCT = 5, 100
# Ownership: after you set a level it's yours until the room's light changes
# this much (log10 lux, ~2x) from when you set it, or HOLD_MAX passes.
HOLD_DECADES = 0.3
HOLD_MAX = 3 * 3600
OFFSET_REACH = 0.5       # decades over which "dimmer/brighter than the curve here" fades out
OFFSET_HALF_LIFE = 1800  # ... and seconds
# Evidence and the fit.
MIN_DWELL = 3.0          # a level kept less than this was passed on the way: not evidence
DWELL_CAP = 2 * 3600
APPROVE_EVERY = 20 * 60  # an untouched stretch of automatic brightness this long is a silent approval
APPROVE_WEIGHT = 0.3     # ... worth this much of an equally long manual choice
SEED_DWELL = 30 * 60     # what migrated curve points count as
HALF_LIFE = 14 * 86400   # evidence weight halves every two weeks
MAX_AGE = 60 * 86400
MAX_EVENTS = 2000
BANDWIDTH = 0.25         # decades of log lux an event informs
CROSS_PHASE = 0.15       # how much daytime evidence counts at night (and vice versa)
GRID = [i / 10 for i in range(46)]   # log10(lux + 1), 0 .. 4.5

# White point
NIGHT_K = int(os.environ.get("NIGHT_TEMP", 4500))
LIT_WARMEST_K = 5000     # the lit-room model never goes warmer than this
NEUTRAL_K = 6600         # ~identity in hyprsunset
MIN_K, MAX_K = 4500, 6600  # overall limits, manual corrections included (4500 = night default, the floor)
D65 = 1e6 / 6500
ADAPT = 0.35             # fraction of the ambient-vs-D65 mired offset to follow
TAU = 90.0               # ambient colour smoothing (s)
TAU_LUX = 30.0           # lux smoothing for the white point (s)
NIGHT_LUX = 3.0          # dark fade reaches NIGHT_K at and below this
CUTOFF_LUX = 20.0        # assumed colour cutoff when starting up already dark
DARK_AFTER = 15.0        # seconds of "can't measure" readings before dark
LIT_AFTER = 3.0          # seconds of real readings before lit
RATE = 0.8               # max mired/s of change (a dark<->lit swing takes ~90 s)
RESEND = 30.0
HOLD_K = 150             # a glide starts only once the target is this far from the screen
STEP_K = 20              # glide resolution: steps small enough not to see
# White point learning: evidence like brightness's (dwell, recency, kind above).
WHITE_BANDWIDTH = 0.3    # decades of log lux a white point choice informs
PHASE_SIGMA = 0.35       # nightness (0 day .. 1 night) a choice informs
WHITE_PRIOR = 0.5        # weight of "the plain model is right": thin evidence moves it less
WHITE_EVENT_RE = re.compile(
    r"^(\d+(?:\.\d+)?) .*white: learned (\d+(?:\.\d+)?) lux(?:, (?:day|night) \(([\d.]+)\))? -> (\d+)K "
    r"\(([+-][\d.]+) mired vs model (\d+)K\)")
DEFAULT_COLORTEMP_RAW = 4500000   # the "too dark to measure" reading


def L(lux):
    return math.log10(lux + 1.0)


def mired(k):
    return 1e6 / k


def log(msg):
    print(msg, flush=True)


# ---------------------------------------------------------------- state

class Store:
    def __init__(self):
        try:
            self.d = json.loads(STATE.read_text())
        except (OSError, ValueError):
            self.d = {}
        if "brightness" not in self.d:
            try:
                self.d["brightness"] = json.loads(OLD_BRIGHTNESS.read_text())["nits"]
            except (OSError, ValueError, KeyError):
                pass
        if "dark_fade" not in self.d:
            try:
                self.d["dark_fade"] = json.loads(OLD_WHITE.read_text())
            except (OSError, ValueError):
                pass

    def save(self):
        try:
            STATE.parent.mkdir(parents=True, exist_ok=True)
            tmp = STATE.with_suffix(".tmp")
            tmp.write_text(json.dumps(self.d, indent=1) + "\n")
            tmp.replace(STATE)
        except OSError as e:
            log(f"couldn't save state: {e}")


def interpolate(points, lux, reach=None):
    """Linear in log lux between points. Past the ends: flat, or (with reach)
    fading linearly to 0 over `reach` decades."""
    if not points:
        return 0.0
    x = L(lux)
    xs = [(L(a), b) for a, b in points]
    if x <= xs[0][0]:
        y = xs[0][1]
        return y if reach is None else y * max(0.0, 1 - (xs[0][0] - x) / reach)
    if x >= xs[-1][0]:
        y = xs[-1][1]
        return y if reach is None else y * max(0.0, 1 - (x - xs[-1][0]) / reach)
    for (x0, y0), (x1, y1) in zip(xs, xs[1:]):
        if x0 <= x <= x1:
            return y0 + (y1 - y0) * (x - x0) / (x1 - x0) if x1 > x0 else y1
    return xs[-1][1]


# ---------------------------------------------------------------- sun

def solar_elevation(lat, lon, when=None):
    """Degrees above the horizon (NOAA's approximation; a fraction of a degree)."""
    t = when or datetime.now(timezone.utc)
    day = t.timetuple().tm_yday
    hour = t.hour + t.minute / 60 + t.second / 3600
    g = 2 * math.pi / 365 * (day - 1 + (hour - 12) / 24)
    eqtime = 229.18 * (0.000075 + 0.001868 * math.cos(g) - 0.032077 * math.sin(g)
                       - 0.014615 * math.cos(2 * g) - 0.040849 * math.sin(2 * g))
    decl = (0.006918 - 0.399912 * math.cos(g) + 0.070257 * math.sin(g) - 0.006758 * math.cos(2 * g)
            + 0.000907 * math.sin(2 * g) - 0.002697 * math.cos(3 * g) + 0.00148 * math.sin(3 * g))
    ha = math.radians((hour * 60 + eqtime + 4 * lon) / 4 - 180)
    la = math.radians(lat)
    cos_zenith = math.sin(la) * math.sin(decl) + math.cos(la) * math.cos(decl) * math.cos(ha)
    return 90 - math.degrees(math.acos(max(-1.0, min(1.0, cos_zenith))))


def lookup_location():
    """(lat, lon) from wttr.in's IP lookup, or None."""
    try:
        with urllib.request.urlopen("https://wttr.in/?format=j1", timeout=15) as r:
            area = json.load(r)["nearest_area"][0]
        return float(area["latitude"]), float(area["longitude"])
    except (OSError, ValueError, KeyError, IndexError):
        return None


# ---------------------------------------------------------------- sensor

def find_sensor():
    for d in Path("/sys/bus/iio/devices").glob("iio:device*"):
        try:
            if (d / "name").read_text().strip() == "als":
                return d
        except OSError:
            pass
    return None


def sensor_attr(sensor, name, default):
    try:
        return float((sensor / name).read_text())
    except (OSError, ValueError):
        return default


class Sensor(threading.Thread):
    """Samples (time, lux, colortemp raw or None), as fast as the hub answers."""

    def __init__(self, path):
        super().__init__(daemon=True)
        self.lux_path = path / "in_illuminance_raw"
        self.color_path = path / "in_colortemp_raw"
        self.scale = sensor_attr(path, "in_illuminance_scale", 1.0)
        self.offset = sensor_attr(path, "in_illuminance_offset", 0.0)
        self.lock = threading.Lock()
        self.samples = []

    def run(self):
        n = 0
        while True:
            raw = None
            if n % COLOR_EVERY == 0:
                try:
                    raw = int(self.color_path.read_text())
                except (OSError, ValueError):
                    pass
            n += 1
            try:
                lux = max(0.0, (float(self.lux_path.read_text()) + self.offset) * self.scale)
            except (OSError, ValueError):
                time.sleep(1)
                continue
            with self.lock:
                self.samples.append((time.monotonic(), lux, raw))

    def take(self):
        with self.lock:
            out, self.samples = self.samples, []
        return out


# ---------------------------------------------------------------- hyprland

def hypr_socket():
    run = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if sig:
        return f"{run}/hypr/{sig}/.socket.sock"
    socks = sorted(Path(run, "hypr").glob("*/.socket.sock"), key=lambda p: p.stat().st_mtime)
    return str(socks[-1]) if socks else None


def hypr_json(command):
    """Like `hyprctl -j <command>`, without spawning hyprctl."""
    path = hypr_socket()
    if not path:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(3)
            s.connect(path)
            s.sendall(f"j/{command}".encode())
            data = b""
            while chunk := s.recv(65536):
                data += chunk
        return json.loads(data)
    except (OSError, ValueError):
        return None


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


_sunset_started = 0.0


def sunset(*args):
    """hyprctl hyprsunset ..., starting hyprsunset if it isn't running.

    Nothing else starts it at login (Omarchy only does when night light is
    toggled), so after a fresh login every send would fail. Started the way
    Omarchy's night light does it; the caller retries on its next tick."""
    global _sunset_started
    if run("hyprctl", "hyprsunset", *args):
        return True
    now = time.monotonic()
    if now - _sunset_started >= 10 and not run("pgrep", "-x", "hyprsunset"):
        _sunset_started = now
        log("white: hyprsunset not running; starting it")
        try:
            subprocess.Popen(["uwsm-app", "--", "hyprsunset"], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            pass
    return False


# ---------------------------------------------------------------- brightness

def hour_now():
    t = time.localtime()
    return t.tm_hour + t.tm_min / 60


def hour_gap(a, b):
    """Hours between two times of day, round the 24 h circle."""
    d = abs(a - b) % 24
    return min(d, 24 - d)


def weighted_median(pairs):
    """pairs: [(value, weight)]."""
    pairs = sorted(pairs)
    half = sum(w for _, w in pairs) / 2
    acc = 0.0
    for v, w in pairs:
        acc += w
        if acc >= half:
            return v
    return pairs[-1][0]


def isotonic(values, weights):
    """Weighted pool-adjacent-violators: the closest non-decreasing sequence."""
    blocks = []   # [mean, weight, count]
    for v, w in zip(values, weights):
        blocks.append([v, w, 1])
        while len(blocks) > 1 and blocks[-2][0] > blocks[-1][0]:
            v2, w2, c2 = blocks.pop()
            v1, w1, c1 = blocks.pop()
            w = w1 + w2
            blocks.append([(v1 * w1 + v2 * w2) / w if w else (v1 + v2) / 2, w, c1 + c2])
    out = []
    for v, _, c in blocks:
        out += [v] * c
    return out


class Brightness:
    """Learns screen brightness (in nits) as a function of room light and time of day.

    Evidence, not a curve: every manual choice is kept as an event (room light,
    time of day, nits, how long you kept it), plus "silent approvals" when an
    automatic level goes untouched for APPROVE_EVERY. The curve is refitted
    from all of it: kernel-weighted (by closeness in log lux and in time of day,
    by how long a level was kept, and by recency) robust medians on a grid,
    made non-decreasing in lux by weighted isotonic regression. One odd moment
    is a small weight among many and can never erase what was learned.

    Who changed the level is known, not guessed: hdr-brightness stamps SOURCE
    on every user change (keys, bar slider); this daemon writes with --auto.
    After a user change the level is the user's until the room's light moves
    HOLD_DECADES or HOLD_MAX passes (below MIN_PCT: until the user changes it).
    Then automatic control resumes from there, carrying the user's offset from
    the curve and easing it out as the light keeps changing.
    """

    def __init__(self, store):
        self.store = store
        self.events = store.d.get("brightness_events")
        if self.events is None:                 # migrate the old learned points
            now = time.time()
            pts = store.d.get("brightness") or []
            self.events = [{"t": now, "x": round(L(a), 3), "h": None, "nits": float(b),
                            "k": "seed", "d": SEED_DWELL} for a, b in pts]
            store.d["brightness_events"] = self.events
            store.save()
            if pts:
                log(f"brightness: seeded evidence from {len(pts)} learned points")
        self.smooth = None       # smoothed log lux
        self.last_t = None
        self.white = None        # nits at 100%
        self.hdr = None
        self.last_set = None     # the level as last seen or written (%)
        self.owner = "auto"      # "auto" | "user"
        self.hold_x = None       # log lux when the user took over
        self.hold_since = 0.0
        self.open = None         # the user's current choice, not yet closed into evidence
        self.offset = 0.0        # nits the user wanted above/below the curve, carried on release
        self.offset_x = None
        self.offset_t = 0.0
        self.source_mtime = self.mtime(SOURCE)
        self.last_check = 0.0
        self.next_step = 0.0
        self.fading = False
        self.stable_since = None # wall time automatic brightness has sat untouched since
        self.curve = None        # (hour, grid nits) cache
        self.curve_at = 0.0
        self.last_status = 0.0
        self.resume_user_hold()

    # ------------------------------------------------------------ evidence and fit

    @staticmethod
    def mtime(path):
        try:
            return path.stat().st_mtime_ns
        except OSError:
            return None

    def weight(self, e, now, hour):
        dwell = math.log1p(min(e.get("d", 0), DWELL_CAP) / 30.0)
        recency = 0.5 ** (max(0.0, now - e["t"]) / HALF_LIFE)
        kind = APPROVE_WEIGHT if e["k"] == "approve" else 1.0
        h = e.get("h")
        if h is None:
            when = 1.0                          # seeds: any time of day
        else:
            when = max(CROSS_PHASE, math.exp(-0.5 * (hour_gap(h, hour) / 2.0) ** 2))
        return dwell * recency * kind * when

    def fit(self, hour):
        """Grid of nits over GRID (log lux) for this time of day."""
        now = time.time()
        weighted = [(e, self.weight(e, now, hour)) for e in self.events]
        values, weights = [], []
        for c in GRID:
            pairs = []
            for e, w in weighted:
                k = math.exp(-0.5 * ((e["x"] - c) / BANDWIDTH) ** 2)
                if k * w > 1e-4:
                    pairs.append((e["nits"], k * w))
            total = sum(w for _, w in pairs)
            values.append(weighted_median(pairs) if total > 0.02 else None)
            weights.append(total)
        known = [i for i, v in enumerate(values) if v is not None]
        if not known:
            return [interpolate(DEFAULT_POINTS, 10 ** c - 1) for c in GRID]
        for i, v in enumerate(values):          # fill gaps: interpolate, flat past the ends
            if v is None:
                lo = max((j for j in known if j < i), default=None)
                hi = min((j for j in known if j > i), default=None)
                if lo is None: values[i] = values[hi]
                elif hi is None: values[i] = values[lo]
                else: values[i] = values[lo] + (values[hi] - values[lo]) * (i - lo) / (hi - lo)
                weights[i] = 1e-3
        return isotonic(values, weights)

    def model(self, x):
        """Nits the evidence suggests at log lux x, now."""
        hour = hour_now()
        now = time.monotonic()
        if self.curve is None or now - self.curve_at > 600 or hour_gap(self.curve[0], hour) > 0.25:
            self.curve, self.curve_at = (hour, self.fit(hour)), now
        grid = self.curve[1]
        if x <= GRID[0]: return grid[0]
        if x >= GRID[-1]: return grid[-1]
        i = int(x * 10)
        f = x * 10 - i
        return grid[i] + (grid[i + 1] - grid[i]) * f

    def add_event(self, e):
        now = time.time()
        self.events.append(e)
        self.events = [ev for ev in self.events if now - ev["t"] < MAX_AGE][-MAX_EVENTS:]
        self.store.d["brightness_events"] = self.events
        self.store.save()
        self.curve = None

    def close_open(self):
        if not self.open:
            return
        e, self.open = self.open, None
        e["d"] = round(min(time.time() - e["t"], DWELL_CAP), 1)
        if e["d"] < MIN_DWELL:
            return
        self.add_event(e)
        log(f"brightness: kept {e['nits']:.0f} nits at {10 ** e['x'] - 1:.0f} lux, "
            f"{e['h']:.1f} h, for {e['d']:.0f} s")

    # ------------------------------------------------------------ control

    def adopt(self):
        """Take the current level as automatic's without learning it (SIGUSR1)."""
        self.owner, self.open, self.offset = "auto", None, 0.0
        self.last_set, self.fading, self.stable_since = None, False, None

    def resume_user_hold(self):
        """After a restart, a recent user change still owns the level."""
        try:
            kind, when, pct = SOURCE.read_text().split()[:3]
            if kind == "user" and time.time() - float(when) < HOLD_MAX:
                self.owner, self.hold_since = "user", time.monotonic()
        except (OSError, ValueError):
            pass

    def feed(self, t, lux):
        x = L(lux)
        if self.smooth is None:
            self.smooth = x
        else:
            tau = TAU_UP if x > self.smooth else TAU_DOWN
            self.smooth += (x - self.smooth) * (1 - math.exp(-(t - self.last_t) / tau))
        self.last_t = t

    def edp_state(self):
        m = next((m for m in hypr_json("monitors") or [] if m.get("name") == MONITOR), None)
        if not (m and not m.get("disabled") and m.get("dpmsStatus", True)):
            return None
        return m.get("sdrMaxLuminance"), m.get("colorManagementPreset") == "hdr"

    def get_pct(self, hdr):
        if hdr:
            try:
                return int(float(LEVEL.read_text()) * 100 + 0.5)
            except OSError:
                return 100
            except ValueError:
                return None
        try:
            out = subprocess.run(["hdr-brightness", "--monitor", MONITOR],
                                 capture_output=True, text=True, timeout=5)
            return int(out.stdout.strip())
        except (OSError, subprocess.SubprocessError, ValueError):
            return None

    def user_changed(self, pct, now):
        self.close_open()                       # the previous choice, with its dwell
        self.owner, self.hold_x, self.hold_since = "user", self.smooth, now
        self.last_set, self.fading, self.stable_since, self.offset = pct, False, None, 0.0
        if pct >= MIN_PCT and self.white:
            self.open = {"t": time.time(), "x": round(self.smooth, 3), "h": round(hour_now(), 2),
                         "nits": round(pct * self.white / 100, 1), "k": "user", "d": 0}

    def release(self, now, why):
        self.close_open()
        if self.last_set is not None and self.white and self.hold_x is not None:
            self.offset = self.last_set * self.white / 100 - self.model(self.hold_x)
            self.offset_x, self.offset_t = self.hold_x, now
        self.owner, self.stable_since = "auto", None
        log(f"brightness: {why}; automatic again (carrying {self.offset:+.0f} nits)")

    def target_pct(self, now):
        nits = self.model(self.smooth)
        if self.offset and self.offset_x is not None:
            fade = math.exp(-abs(self.smooth - self.offset_x) / OFFSET_REACH) \
                * 0.5 ** ((now - self.offset_t) / OFFSET_HALF_LIFE)
            nits += self.offset * fade
        return int(round(min(MAX_PCT, max(MIN_PCT, 100 * nits / self.white))))

    def write_status(self, now, target):
        try:
            STATUS.write_text(json.dumps({
                "time": time.strftime("%H:%M:%S"), "lux": round(10 ** self.smooth - 1, 1),
                "hour": round(hour_now(), 2), "level": self.last_set, "owner": self.owner,
                "target": target, "model_nits": round(self.model(self.smooth), 1), "white": self.white,
                "hold_lux": None if self.hold_x is None else round(10 ** self.hold_x - 1, 1),
                "offset_nits": round(self.offset, 1), "events": len(self.events),
                "open": self.open}, indent=1) + "\n")
        except OSError:
            pass

    def tick(self, now):
        if self.smooth is None:
            return

        # Who changed it is told, not guessed: hdr-brightness stamps SOURCE.
        m = self.mtime(SOURCE)
        if m != self.source_mtime:
            self.source_mtime = m
            try:
                kind, _, pct = SOURCE.read_text().split()[:3]
                if kind == "user":
                    self.user_changed(int(pct), now)
            except (OSError, ValueError):
                pass

        if now - self.last_check >= 1.0:
            self.last_check = now
            state = self.edp_state()
            nits = state[0] if state else None
            self.hdr = state[1] if state else None
            current = self.get_pct(self.hdr) if nits else None
            if current is None:
                return
            try:
                self.white = float(WHITE.read_text())
            except (OSError, ValueError):
                self.white = nits * 100 / current if current else 200.0
            if self.last_set is None:
                self.last_set = current
            elif current != self.last_set:      # changed by something unannounced: don't fight it
                self.user_changed(current, now)

        if self.owner == "user":
            if self.hold_x is None:
                self.hold_x = self.smooth        # resumed after a restart: hold from here
            if self.last_set is not None and self.last_set >= MIN_PCT and self.hold_x is not None:
                if abs(self.smooth - self.hold_x) >= HOLD_DECADES:
                    self.release(now, f"room light changed ({10 ** self.smooth - 1:.0f} lux)")
                elif now - self.hold_since > HOLD_MAX:
                    self.release(now, "held for 3 h")
            if self.owner == "user":
                if now - self.last_status > 2:
                    self.last_status = now
                    self.write_status(now, None)
                return

        if self.last_set is None or not self.white:
            return
        target = self.target_pct(now)
        if now - self.last_status > 2:
            self.last_status = now
            self.write_status(now, target)

        diff = target - self.last_set
        if now >= self.next_step and (abs(diff) >= DEADBAND or (self.fading and diff != 0)):
            current = self.get_pct(self.hdr) if self.hdr is not None else None
            if current is not None and current != self.last_set:
                self.user_changed(current, now)
                return
            self.fading, self.stable_since = True, None
            step = 1 if diff > 0 else -1
            self.last_set += step
            run("hdr-brightness", "--auto", "--no-osd", "--monitor", MONITOR, f"{self.last_set}%")
            self.next_step = now + (STEP_EVERY_UP if step > 0 else STEP_EVERY_DOWN)
            return
        if diff == 0 or abs(diff) < DEADBAND:
            self.fading = False
        # Untouched automatic brightness is a (weak) approval of it.
        wall = time.time()
        if self.stable_since is None:
            self.stable_since = wall
        elif wall - self.stable_since >= APPROVE_EVERY:
            self.stable_since = wall
            self.add_event({"t": wall, "x": round(self.smooth, 3), "h": round(hour_now(), 2),
                            "nits": round(self.last_set * self.white / 100, 1), "k": "approve",
                            "d": APPROVE_EVERY})


# ---------------------------------------------------------------- white point

class WhitePoint:
    def __init__(self, store):
        self.store = store
        self.neutral, self.night = mired(NEUTRAL_K), mired(NIGHT_K)
        self.lit_warmest = mired(LIT_WARMEST_K)
        self.lo, self.hi = mired(MAX_K), mired(MIN_K)
        self.night_lo = L(NIGHT_LUX)
        loc = store.d.get("location")
        self.location = (loc["lat"], loc["lon"]) if loc else None
        self.events = store.d.get("white_events")
        migrated = self.events is None
        if migrated:
            self.events = self.seed_events()
            store.d["white_events"] = self.events
            store.save()
        self.fit_key, self.fit_at, self.fit = None, 0.0, 0.0
        if self.location is None:
            threading.Thread(target=self.find_location, daemon=True).start()
        fade = store.d.get("dark_fade") or {}
        self.lit_target = fade.get("lit_mired")      # dark fade starts here (mired) ...
        self.fade_hi = fade.get("cutoff_loglux")     # ... at this log lux (colour lost)
        self.saved_fade = (self.lit_target, self.fade_hi)
        self.last_fade_save = 0.0
        self.ambient = None      # smoothed ambient mired while lit
        self.loglux = None       # smoothed log lux
        self.last_t = None
        self.last_color_t = None
        self.dark = None
        self.default_since = None
        self.real_since = None
        self.current = None      # mired value on screen (as last set)
        self.sent = None         # kelvin last sent
        self.last_send = 0.0
        self.last_override = None
        self.gliding = False     # moving toward the target (vs holding still)
        self.hold = None         # the user's choice while it owns the screen (see tick)
        self.send_ok = False
        self.stable_since = None # automatic white untouched since (for silent approvals)
        self.manual_mtime = self.mtime()
        if not migrated:         # after a restart a recent choice still owns the screen
            try:
                age = time.time() - MANUAL_WHITE.stat().st_mtime
                k = int(MANUAL_WHITE.read_text().split()[0])
                if age < HOLD_MAX:
                    self.hold = {"value": mired(k), "since": time.monotonic() - age, "x": None, "event": None}
                    self.current, self.sent = mired(k), k
            except (OSError, ValueError, IndexError):
                pass

    @staticmethod
    def mtime():
        try:
            return MANUAL_WHITE.stat().st_mtime_ns
        except OSError:
            return None

    def feed(self, t, lux, raw):
        x = L(lux)
        a = None if self.last_t is None else 1 - math.exp(-(t - self.last_t) / TAU_LUX)
        self.loglux = x if a is None else self.loglux + (x - self.loglux) * a
        if raw is not None:
            if raw == DEFAULT_COLORTEMP_RAW:
                self.default_since = self.default_since or t
                self.real_since = None
            else:
                self.real_since = self.real_since or t
                self.default_since = None
                amb = mired(max(raw, 1000000) / 1000.0)
                if self.ambient is None or self.last_color_t is None:
                    self.ambient = amb
                else:
                    self.ambient += (amb - self.ambient) * (1 - math.exp(-(t - self.last_color_t) / TAU))
                self.fade_hi = self.loglux
            self.last_color_t = t
        self.last_t = t

    def model(self):
        """The plain model's target (mired), before learned corrections."""
        if self.dark:
            start = self.lit_target if self.lit_target is not None else self.lit_warmest
            hi = self.fade_hi if self.fade_hi is not None else L(CUTOFF_LUX)
            if self.loglux is None or hi - self.night_lo < 0.05:
                f = 1.0
            else:
                f = min(1.0, max(0.0, (hi - self.loglux) / (hi - self.night_lo)))
            return self.night if f >= 1.0 else start + f * (self.night - start)
        if self.ambient is not None:
            t = min(max(self.neutral + ADAPT * (self.ambient - D65), self.neutral), self.lit_warmest)
            self.lit_target = t
            return t
        return None

    def find_location(self):
        for wait in (0, 60, 300, 1800):
            time.sleep(wait)
            loc = lookup_location()
            if loc:
                self.location = loc
                self.store.d["location"] = {"lat": loc[0], "lon": loc[1]}
                self.store.save()
                log(f"white: location {loc[0]:.2f}, {loc[1]:.2f}")
                return

    def nightness(self):
        """0 = day, 1 = night, in between through civil twilight."""
        if self.location:
            elev = solar_elevation(*self.location)
            return min(1.0, max(0.0, (6 - elev) / 12))
        return 0.0 if 7 <= time.localtime().tm_hour < 18 else 1.0

    # ------------------------------------------------------------ evidence

    def night_at(self, wall):
        if self.location:
            elev = solar_elevation(*self.location, datetime.fromtimestamp(wall, timezone.utc))
            return min(1.0, max(0.0, (6 - elev) / 12))
        return 0.0 if 7 <= time.localtime(wall).tm_hour < 18 else 1.0

    def seed_events(self):
        """First run of the evidence model: every white point choice still in
        the journal (the learned-offset points kept only the latest near each
        lux), each kept until the next one. Falls back to those points."""
        try:
            out = subprocess.run(["journalctl", "--user", "-u", "ambient-display", "-u", "ambient-white",
                                  "-o", "short-unix", "--no-pager"],
                                 capture_output=True, text=True, timeout=60).stdout
        except (OSError, subprocess.SubprocessError):
            out = ""
        found = []
        for line in out.splitlines():
            m = WHITE_EVENT_RE.match(line)
            if m:
                t, lux, n, _, desired, _ = m.groups()
                t = float(t)
                found.append({"t": t, "x": round(L(float(lux)), 3),
                              "n": round(float(n) if n is not None else self.night_at(t), 2),
                              "m": float(desired), "k": "manual"})
        now = time.time()
        for e, nxt in zip(found, found[1:] + [None]):
            e["d"] = round(min((nxt["t"] if nxt else now) - e["t"], DWELL_CAP), 1)
        found = [e for e in found if now - e["t"] < MAX_AGE]
        if found:
            log(f"white: seeded evidence from {len(found)} choices in the journal")
            return found
        wo = self.store.d.get("white_offsets") or {}
        if isinstance(wo, list):
            wo = {"night": wo}
        seeds = [{"t": now, "x": round(L(float(a)), 3), "n": 1.0 if k == "night" else 0.0, "m": float(b),
                  "k": "seed", "d": SEED_DWELL} for k in ("day", "night") for a, b in wo.get(k, [])]
        if seeds:
            log(f"white: seeded evidence from {len(seeds)} learned points")
        return seeds

    def weight(self, e, now):
        dwell = math.log1p(min(e.get("d", 0), DWELL_CAP) / 30.0)
        recency = 0.5 ** (max(0.0, now - e["t"]) / HALF_LIFE)
        return dwell * recency * (APPROVE_WEIGHT if e["k"] == "approve" else 1.0)

    def correction(self):
        """Learned mired correction at the current lux and nightness: the
        weighted median of nearby choices (by closeness in log lux and in
        nightness, how long each was kept, recency), shrunk toward the plain
        model by WHITE_PRIOR so thin evidence moves it less. A brief odd choice
        is one small weight among many and can't decide the result."""
        if self.loglux is None:
            return 0.0
        x, n = self.loglux, self.nightness()
        key = (round(x, 2), round(n, 2), len(self.events), self.events[-1]["t"] if self.events else 0)
        now = time.monotonic()
        if key == self.fit_key and now - self.fit_at < 60:
            return self.fit
        wall = time.time()
        pairs = []
        for e in self.events:
            w = (self.weight(e, wall) * math.exp(-0.5 * ((e["x"] - x) / WHITE_BANDWIDTH) ** 2)
                 * max(CROSS_PHASE, math.exp(-0.5 * ((e["n"] - n) / PHASE_SIGMA) ** 2)))
            if w > 1e-4:
                pairs.append((e["m"], w))
        total = sum(w for _, w in pairs)
        self.fit = weighted_median(pairs) * total / (total + WHITE_PRIOR) if pairs else 0.0
        self.fit_key, self.fit_at = key, now
        return self.fit

    def add_event(self, e):
        now = time.time()
        self.events.append(e)
        self.events = [ev for ev in self.events if now - ev["t"] < MAX_AGE][-MAX_EVENTS:]
        self.store.d["white_events"] = self.events
        self.store.save()
        self.fit_key = None

    def release(self, now, why):
        """The user's choice stops owning the screen; it becomes evidence,
        weighted by how long it was kept."""
        h, self.hold = self.hold, None
        self.stable_since = None
        if not h or h["event"] is None:     # changed again before it settled: passed through
            return
        e = h["event"]
        e["d"] = round(min(now - h["since"], DWELL_CAP), 1)
        if e["d"] < MIN_DWELL:
            return
        self.add_event(e)
        log(f"white: kept {round(1e6 / h['value'])}K at {10 ** e['x'] - 1:.0f} lux, night {e['n']:.2f}, "
            f"{e['m']:+.1f} mired vs model, for {e['d']:.0f} s ({why})")

    def send(self, k):
        self.send_ok = sunset("temperature", str(k))
        return self.send_ok

    def tick(self, now, dt):
        was_dark = self.dark
        if self.default_since is not None and (self.dark is None or now - self.default_since >= DARK_AFTER):
            self.dark = True
        elif self.real_since is not None and (self.dark is None or now - self.real_since >= LIT_AFTER):
            self.dark = False
        if was_dark is not None and self.dark != was_dark:
            clear_override()
            log(f"white: room is now {'dark' if self.dark else 'lit'}")

        if (self.lit_target is not None and self.fade_hi is not None and now - self.last_fade_save >= 60
                and (self.saved_fade[0] is None or self.saved_fade[1] is None
                     or abs(self.lit_target - self.saved_fade[0]) >= 1
                     or abs(self.fade_hi - self.saved_fade[1]) >= 0.02)):
            self.store.d["dark_fade"] = {"lit_mired": round(self.lit_target, 2),
                                         "cutoff_loglux": round(self.fade_hi, 3)}
            self.store.save()
            self.saved_fade, self.last_fade_save = (self.lit_target, self.fade_hi), now

        # TV mode (bin/tv-mode): the TV is the screen, so sRGB's own white,
        # whatever the room is doing here. Nothing is learned meanwhile, and
        # afterwards the model's target comes back at once rather than gliding.
        if TV_MODE.exists():
            if self.hold:
                self.release(now, "TV mode")
            self.manual_mtime, self.current, self.gliding = self.mtime(), None, False
            if (self.sent != "tv" or now - self.last_send >= RESEND) and sunset("identity"):
                if self.sent != "tv":
                    log("white: identity for TV mode")
                self.sent, self.last_send = "tv", now
            return

        # A manual change from `white-point`: it already set hyprsunset. The
        # choice owns the screen until the room's light moves HOLD_DECADES,
        # HOLD_MAX passes, the room turns dark/lit, or the night light toggle is
        # used; then it's kept as evidence and automatic control resumes.
        m = self.mtime()
        if m != self.manual_mtime:
            self.manual_mtime = m
            try:
                k = int(MANUAL_WHITE.read_text().split()[0])
            except (OSError, ValueError, IndexError):
                k = None
            if k:
                if self.hold:
                    self.release(now, "changed again")
                self.hold = {"value": mired(k), "since": now, "x": self.loglux, "event": None}
                self.current, self.sent, self.last_send = mired(k), k, now
                self.gliding = False
                clear_override()

        base = self.model()
        if self.hold:
            h = self.hold
            if h["event"] is None and now - h["since"] >= SETTLE and base is not None and self.loglux is not None:
                h["x"] = self.loglux if h["x"] is None else h["x"]
                h["event"] = {"t": round(time.time() - (now - h["since"]), 1), "x": round(h["x"], 3),
                              "n": round(self.nightness(), 2), "m": round(h["value"] - base, 1), "k": "manual"}
                log(f"white: holding {round(1e6 / h['value'])}K at {10 ** h['x'] - 1:.0f} lux, "
                    f"night {h['event']['n']:.2f} ({h['event']['m']:+.1f} mired vs model {round(1e6 / base)}K)")
            why = None
            if read_override():
                why = "night light toggle"
            elif was_dark is not None and self.dark != was_dark:
                why = "room turned " + ("dark" if self.dark else "lit")
            elif h["x"] is not None and self.loglux is not None and abs(self.loglux - h["x"]) >= HOLD_DECADES:
                why = "room light changed"
            elif now - h["since"] >= HOLD_MAX:
                why = "held long enough"
            if why:
                self.release(now, why)

        override = read_override()
        if override == "night":
            target = self.night
        elif override == "day":
            target = self.neutral
        elif self.hold:
            target = self.hold["value"]
        elif base is not None:
            target = min(self.hi, max(self.lo, base + self.correction()))
        else:
            target = None

        # Silent approval: automatic white left untouched (and actually on
        # screen) for APPROVE_EVERY is weak evidence that it's right here.
        if (target is not None and base is not None and self.loglux is not None and not self.hold
                and not override and not self.gliding and self.send_ok):
            if self.stable_since is None:
                self.stable_since = now
            elif now - self.stable_since >= APPROVE_EVERY:
                self.stable_since = now
                self.add_event({"t": round(time.time(), 1), "x": round(self.loglux, 3), "n": round(self.nightness(), 2),
                                "m": round(target - base, 1), "k": "approve", "d": APPROVE_EVERY})
        else:
            self.stable_since = None

        jump = False
        if target is not None:
            if self.current is None or (override and override != self.last_override):
                self.current, jump, self.gliding = target, True, False
            else:
                if not self.gliding and self.sent is not None:
                    if abs(1e6 / target - self.sent) >= HOLD_K:
                        self.gliding = True
                        lux = f", {10 ** self.loglux - 1:.0f} lux" if self.loglux is not None else ""
                        why = f"override {override}" if override else ("dark" if self.dark else "lit") + lux
                        log(f"white: gliding {self.sent}K -> {round(1e6 / target)}K ({why})")
                    else:
                        self.current = mired(self.sent)   # hold still: wobble isn't change
                if self.gliding:
                    step = RATE * dt
                    self.current += max(-step, min(step, target - self.current))
                    if self.current == target:
                        self.gliding = False
        self.last_override = override
        if self.current is None:
            return

        value = min(MAX_K, max(MIN_K, int(round(1e6 / self.current / STEP_K) * STEP_K)))
        if (value != self.sent or now - self.last_send >= RESEND) and self.send(value):
            if jump:
                log(f"white: -> {value}K" + (f" (override {override})" if override else ""))
            self.sent, self.last_send = value, now


def read_override():
    try:
        v = OVERRIDE.read_text().strip()
        return v if v in ("night", "day") else None
    except OSError:
        return None


def clear_override():
    try:
        OVERRIDE.unlink()
    except OSError:
        pass


# ---------------------------------------------------------------- main

def main():
    path = find_sensor()
    if path is None:
        raise SystemExit("no iio 'als' sensor found")
    store = Store()
    brightness = Brightness(store)
    white = WhitePoint(store)
    signal.signal(signal.SIGUSR1, lambda *_: brightness.adopt())

    sensor = Sensor(path)
    sensor.start()
    prev = time.monotonic()
    while True:
        now = time.monotonic()
        dt, prev = now - prev, now
        for t, lux, raw in sensor.take():
            brightness.feed(t, lux)
            white.feed(t, lux, raw)
        brightness.tick(now)
        white.tick(now, dt)
        time.sleep(TICK)


if __name__ == "__main__":
    main()
