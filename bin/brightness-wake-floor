#!/bin/bash
# On wake from suspend, make sure the internal screen is bright enough to see
# the lock screen: raise brightness to FLOOR% if it's below that (e.g. dimmed
# to 0 before sleeping). Called from after_sleep_cmd in hypr/hypridle.conf.
#
# ambient-display ignores a screen below 5% and would learn any other change
# it didn't make as a manual preference, so after raising, SIGUSR1 tells it to
# adopt the current level without learning it; it then fades to its usual
# level for the room.
set -uo pipefail

FLOOR=${FLOOR:-5}
PATH="$HOME/.local/bin:$PATH"

# The display may still be coming back right after resume; retry briefly.
current=""
for _ in $(seq 20); do
  current=$(hdr-brightness --monitor eDP-1 2>/dev/null) && [[ $current =~ ^[0-9]+$ ]] && break
  current=""
  sleep 0.25
done
[[ -n $current ]] || { echo "brightness-wake-floor: couldn't read brightness" >&2; exit 0; }

(( current >= FLOOR )) && exit 0

hdr-brightness --no-osd --monitor eDP-1 "${FLOOR}%"
echo "brightness-wake-floor: raised brightness ${current}% -> ${FLOOR}%"

systemctl --user kill -s USR1 ambient-display.service 2>/dev/null || true
