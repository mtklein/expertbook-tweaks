#!/bin/bash
# Manual white point, for the Shift + brightness keys (hypr/bindings.lua).
#
# Records the value in ~/.local/state/white-point.manual, where ambient-display
# picks it up at once: the choice holds the screen until the room changes, then
# it's kept as evidence of what you like in that light.
#
# Kelvin here is real: the patched Hyprland (hyprland-patched/06) applies the
# white point in linear light, so white takes the colour asked for.
#
# Usage: white-point [--no-osd] [warmer | cooler | N]   (N in kelvin; no argument prints the current value)
#        Shift + dim = warmer, Shift + bright = cooler: to the next of nine
#        round marks, about 30 mired apart (even to the eye across the range).

MARKS=(2500 2700 3000 3300 3700 4200 4800 5600 6600)   # ends: keep in step with MIN_K/MAX_K in ambient-display
MIN=${MARKS[0]} MAX=${MARKS[-1]}

no_osd=0
[[ ${1:-} == --no-osd ]] && { no_osd=1; shift; }
state="${XDG_STATE_HOME:-$HOME/.local/state}"

# ambient-display owns the screen's white point (through its white-point-ctm
# helper) and publishes the kelvin on screen; a change is handed to it through
# white-point.manual and shows within a tenth of a second.
current=$(cat "${XDG_RUNTIME_DIR:-/run/user/$UID}/white-point" 2>/dev/null)
# Never guess: a made-up starting point would be learned as a preference.
[[ $current =~ ^[0-9]+$ ]] || { echo "white-point: ambient-display isn't running" >&2; exit 1; }
if [[ -z ${1:-} ]]; then
  echo "$current"
  exit 0
fi

target=$current
case $1 in
  cooler) for m in "${MARKS[@]}"; do (( m > current )) && { target=$m; break; }; done ;;
  warmer) for (( i = ${#MARKS[@]} - 1; i >= 0; i-- )); do (( MARKS[i] < current )) && { target=${MARKS[i]}; break; }; done ;;
  [0-9]*) target=$(( ($1 + 50) / 100 * 100 )) ;;
  *) echo "usage: white-point [--no-osd] [warmer | cooler | N]" >&2; exit 1 ;;
esac
(( target > MAX )) && target=$MAX
(( target < MIN )) && target=$MIN

mkdir -p "$state" && echo "$target" > "$state/white-point.manual"

if (( ! no_osd )); then
  # The bar is even in mireds, like the steps: empty at MIN, full at MAX.
  pct=$(awk -v t="$target" -v lo="$MIN" -v hi="$MAX" 'BEGIN { printf "%d", (1e6/lo - 1e6/t) / (1e6/lo - 1e6/hi) * 100 + 0.5 }')
  payload=$(jq -cn --arg icon $'\U000F050F' --arg value "$pct" --arg text "${target}K" \
    '{icon:$icon,message:"",value:$value,progressText:$text,max:"100",duration:""}')
  omarchy-shell -q osd show "$payload"
fi
