#!/bin/bash
# Run a game the way this laptop likes them. As a Steam launch option:
#
#     game %command%
#
# What it sets up:
#   - A native Wayland window where the game can make one (SDL games such as
#     Baldur's Gate 3), falling back to X11. That is what lets a game send HDR
#     straight to Hyprland; touch and sound work as usual, and Hyprland's
#     variable refresh applies when the game is fullscreen.
#   - MangoHud loaded but hidden. Right Shift + F12 shows and hides it
#     (~/.config/MangoHud/MangoHud.conf: one compact line, top left).
#
# Anything already set in the launch option wins, e.g.
#     SDL_VIDEODRIVER=x11 game %command%
#     MANGOHUD_CONFIG=read_cfg game %command%        (overlay visible from the start)
#
# Not gamescope: nested in Hyprland it passes no touch to the game, and
# Baldur's Gate 3 stayed silent in it (it mutes itself when it thinks it has
# lost focus).
#
# Per game, by Steam's app id:
#   - Final Fantasy XIII (292120): held in the performance power profile while
#     it runs, if started on mains power. It is a 32-bit game: the overlay
#     needs lib32-mangohud. To log frame times for tuning, add to the launch option
#     MANGOHUD_CONFIG=read_cfg,no_display,output_folder=$HOME/mangohud-logs,autostart_log=20,log_interval=50
#
# For an old game that works one thread hard, `pinned-game %command%` is this
# with the game kept on the performance cores.
(( $# > 0 )) || { echo "usage: game command..." >&2; exit 1; }
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-wayland,x11}"
hud="read_cfg,no_display"
hold=()
case ${SteamAppId:-} in
  292120)
    # Only on mains power, as it stands at launch; on battery, stay balanced.
    [[ $(cat /sys/class/power_supply/AC0/online 2>/dev/null) == 1 ]] && command -v powerprofilesctl >/dev/null &&
      hold=(powerprofilesctl launch -p performance -r "game" --) ;;
esac
export MANGOHUD_CONFIG="${MANGOHUD_CONFIG:-$hud}"
command -v mangohud >/dev/null && hold+=(mangohud)

# EXPERIMENT (2026-11-11): the LAVD scheduler (sched_ext, from scx-scheds and
# scx-tools) while a game runs, in place of the kernel's own, to see whether
# it keeps an old game's one busy thread on a fast core without pinned-game.
# It follows the power profile (--autopower) and is system-wide while loaded.
# Started here if nothing is loaded, and stopped again when the game ends;
# each of those asks for the password (polkit) unless one was given in the
# last few minutes. GAME_SCHED=none in the launch option skips it.
sched=${GAME_SCHED:-lavd}
if [[ $sched != none ]] && command -v scxctl >/dev/null && scxctl get 2>/dev/null | grep -q '^no scx'; then
  if scxctl start -s "$sched" -a="--autopower" >/dev/null 2>&1; then
    "${hold[@]}" "$@"
    status=$?
    scxctl stop >/dev/null 2>&1
    exit $status
  fi
fi
exec "${hold[@]}" "$@"
