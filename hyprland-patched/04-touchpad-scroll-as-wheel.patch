diff --git a/src/managers/input/InputManager.cpp b/src/managers/input/InputManager.cpp
index b39f439..16e283c 100644
--- a/src/managers/input/InputManager.cpp
+++ b/src/managers/input/InputManager.cpp
@@ -1005,6 +1005,12 @@ void CInputManager::onMouseWheel(IPointer::SAxisEvent e, SP<IPointer> pointer) {
     if (!passEvent)
         return;
 
+    bool touchpadAsWheel = false;
+    if (e.source == WL_POINTER_AXIS_SOURCE_FINGER && g_pSeatManager->m_state.pointerFocus) {
+        const auto PSCROLLED = Desktop::viewState()->query().type(Desktop::View::VIEW_TYPE_WINDOW).surface(g_pSeatManager->m_state.pointerFocus.lock()).runWindow();
+        touchpadAsWheel      = PSCROLLED && PSCROLLED->m_ruleApplicator->m_tagKeeper.isTagged("wheel_scroll");
+    }
+
     if (!m_lastFocusOnLS) {
         const auto MOUSECOORDS = g_pInputManager->getMouseCoordsInternal();
         const auto PWINDOW = Desktop::viewState()->hitTest().windowAt(MOUSECOORDS, Desktop::View::RESERVED_EXTENTS | Desktop::View::INPUT_EXTENTS | Desktop::View::ALLOW_FLOATING);
@@ -1045,6 +1051,27 @@ void CInputManager::onMouseWheel(IPointer::SAxisEvent e, SP<IPointer> pointer) {
         }
     }
 
+    if (touchpadAsWheel) {
+        static double   accumulated[2] = {0, 0};
+        static uint32_t lastTime[2]    = {0, 0};
+        const int       AXIS           = e.axis == WL_POINTER_AXIS_VERTICAL_SCROLL ? 0 : 1;
+
+        if (e.timeMs - lastTime[AXIS] > 500)
+            accumulated[AXIS] = 0;
+        lastTime[AXIS] = e.timeMs;
+        accumulated[AXIS] += e.delta * factor;
+
+        const int DETENTS = sc<int>(accumulated[AXIS] / 15.0);
+        if (DETENTS == 0)
+            return;
+        accumulated[AXIS] -= DETENTS * 15.0;
+
+        g_pSeatManager->sendPointerAxis(e.timeMs, e.axis, 15.0 * DETENTS, DETENTS, 120 * DETENTS, WL_POINTER_AXIS_SOURCE_WHEEL, WL_POINTER_AXIS_RELATIVE_DIRECTION_IDENTICAL);
+        m_pointerAxisFramePending = false;
+        g_pSeatManager->sendPointerFrame();
+        return;
+    }
+
     double discrete = (e.deltaDiscrete != 0) ? (factor * e.deltaDiscrete / std::abs(e.deltaDiscrete)) : 0;
     double delta    = e.delta * factor;
 
