+// 06-white-point-linear.patch
+//
+// A monitor's CTM (hyprsunset's white point) is handed to KMS, which applies it
+// to the encoded signal. For a gamma-encoded SDR signal that is a constant
+// linear-light gain per channel ((g*v)^gamma == g^gamma * v^gamma), i.e. a real
+// white point shift. PQ has no such property: there the same matrix tints
+// white far more than the shadows, more the brighter the screen is, and makes
+// the requested colour temperature meaningless. So when the output is PQ and
+// compositing is done in a linear work buffer, the white point is applied
+// here instead, in linear light, as part of every conversion into the
+// output's encoding (the final pass, and the hardware cursor), and KMS gets
+// an identity matrix.
+bool IHyprRenderer::whitePointInShader(PHLMONITOR m) {
+    return m && m->m_imageDescription && m->useFP16() && m->m_imageDescription->value().transferFunction == NColorManagement::CM_TRANSFER_FUNCTION_ST2084_PQ;
+}
+
+// The CTM as a linear-light matrix for RGB in `dst`'s primaries.
+static Hyprgraphics::CMatrix3 linearWhitePoint(const Mat3x3& ctm, const NColorManagement::PImageDescription dst) {
+    const auto c    = ctm.getMatrix();
+    const auto SRGB = NColorManagement::CPrimaries::from(NColorManagement::CM_PRIMARIES_SRGB);
+    const auto DST  = dst->getPrimaries();
+
+    if (c[1] != 0 || c[2] != 0 || c[3] != 0 || c[5] != 0 || c[6] != 0 || c[7] != 0) {
+        // not a plain white point: take it as acting on linear sRGB
+        const Hyprgraphics::CMatrix3 M(std::array<std::array<double, 3>, 3>{{{c[0], c[1], c[2]}, {c[3], c[4], c[5]}, {c[6], c[7], c[8]}}});
+        return SRGB->convertMatrix(DST) * M * DST->convertMatrix(SRGB);
+    }
+
+    // Per-channel gains on display-encoded sRGB: together they are the sRGB
+    // colour white should become. Find that colour's coordinates in dst's
+    // primaries and scale the channels by them (white lands exactly on the
+    // requested chromaticity; no channel is ever boosted or goes negative).
+    const auto   lin    = [](double v) { v = std::clamp(v, 0.0, 1.0); return v <= 0.04045 ? v / 12.92 : std::pow((v + 0.055) / 1.055, 2.4); };
+    const auto   WHITE  = Hyprgraphics::CColor::XYZ{.x = lin(c[0]), .y = lin(c[4]), .z = lin(c[8])};
+    const double level  = std::max({WHITE.x, WHITE.y, WHITE.z});
+    const auto   g      = SRGB->convertMatrix(DST) * WHITE;
+    const double top    = std::max({g.x, g.y, g.z});
+    const double k      = top > 0 ? level / top : 0;
+    return Hyprgraphics::CMatrix3(std::array<std::array<double, 3>, 3>{{{std::max(g.x, 0.0) * k, 0, 0}, {0, std::max(g.y, 0.0) * k, 0}, {0, 0, std::max(g.z, 0.0) * k}}});
+}
