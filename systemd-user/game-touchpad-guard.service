[Unit]
Description=Disable the touchpad while a keyboard/controller-only game is focused
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/bin/game-touchpad-guard
Environment=PATH=%h/.local/bin:/usr/share/omarchy/bin:/usr/local/bin:/usr/bin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
