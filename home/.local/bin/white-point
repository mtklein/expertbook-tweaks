#!/bin/bash
no_osd=0
[[ ${1:-} == --no-osd ]] && { no_osd=1; shift; }

reply=$(socat -t 2 - "UNIX-CONNECT:${XDG_RUNTIME_DIR:-/run/user/$UID}/ambient-display.sock" <<<"white ${1:-}" 2>/dev/null)
[[ -n $reply ]] || reply="err ambient-display isn't running"
read -r status kelvin meter <<<"$reply"
[[ $status == ok ]] || { echo "white-point: ${reply#err }" >&2; exit 1; }
[[ -n ${1:-} ]] || { echo "$kelvin"; exit; }
(( no_osd )) && exit

qs ipc call osd pop white-point "$meter" "$meter%" >/dev/null
