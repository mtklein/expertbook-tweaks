#!/bin/bash
args=("$@")
no_osd=0
monitor=-
while (( $# > 0 )); do
  case $1 in
    --no-osd) no_osd=1; shift ;;
    --monitor) monitor=$2; shift 2 ;;
    *) break ;;
  esac
done
step=${1:-}
level_file="${XDG_STATE_HOME:-$HOME/.local/state}/hdr-brightness"

saved_percent() { awk 'NR == 1 { printf "%d", $1 * 100 + 0.5 }' "$level_file" 2>/dev/null || printf 100; }
on_internal_panel() {
  [[ $monitor != - ]] || monitor=$(omarchy-hyprland-monitor-focused 2>/dev/null)
  [[ $monitor == eDP-1 ]]
}
elsewhere() { exec omarchy-brightness-display "${args[@]}"; }

if [[ -z $step ]]; then
  on_internal_panel || elsewhere
  saved_percent
  echo
  exit
fi

reply=$(socat -t 2 - "UNIX-CONNECT:${XDG_RUNTIME_DIR:-/run/user/$UID}/ambient-display.sock" <<<"brightness $monitor $step" 2>/dev/null)
case $reply in
  "ok "*) percent=${reply#ok } ;;
  elsewhere) elsewhere ;;
  *)
    on_internal_panel && [[ $step =~ ^(\+?)([0-9]+)%(-?)$ ]] || elsewhere
    percent=$(saved_percent)
    if [[ -n ${BASH_REMATCH[1]} ]]; then
      percent=$(( percent + BASH_REMATCH[2] ))
    elif [[ -n ${BASH_REMATCH[3]} ]]; then
      percent=$(( percent - BASH_REMATCH[2] ))
    else
      percent=${BASH_REMATCH[2]}
    fi
    (( percent = percent > 100 ? 100 : percent < 0 ? 0 : percent ))
    level=$(awk -v p="$percent" 'BEGIN { printf "%.4f", p / 100 }')
    hyprctl eval "edp_hdr_level($level)" >/dev/null
    printf '%s\nuser %s\n' "$level" "$(date +%s)" >"$level_file"
    ;;
esac

(( no_osd )) || omarchy-osd -i brightness -p "$percent"
