#!/bin/sh
dir=$(readlink -f "$(dirname "$(readlink -f "$0")")/../../../geforcenow-hdr")
edid=$HOME/.local/state/geforcenow-hdr-edid
"$dir/edid" "$edid" || exit 1
flatpak update --user --noninteractive -y com.nvidia.geforcenow >/dev/null 2>&1
restore() { hyprctl eval 'edp_override_scale()' >/dev/null; }
trap restore EXIT
trap 'exit 129' HUP INT TERM
sdl=$dir/sdl/lib/libSDL2-2.0.so.0
if [ -n "$GFN_PIXELS" ] && [ -e "$sdl" ]; then
  ln -f "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" "$XDG_RUNTIME_DIR/gfn-wayland"
  set -- --filesystem=xdg-run/gfn-wayland --env=WAYLAND_DISPLAY=gfn-wayland --env=SDL_DYNAMIC_API="$sdl"
else
  set --
  hyprctl eval 'edp_override_scale(1)' >/dev/null
fi
flatpak run "$@" \
  --env=SDL_VIDEODRIVER=wayland \
  --env=GAMESCOPE_PATCHED_EDID_FILE="$edid" \
  --env=GFN_FAKE_DIR="$dir/steamos" \
  --env=LD_PRELOAD="$dir/redirect.so" \
  ${GFN_VULKAN_DRIVER:+--env=VK_ICD_FILENAMES="$GFN_VULKAN_DRIVER"} \
  ${GFN_ENV:+$(printf -- "--env=%s " $GFN_ENV)} \
  --command=bash com.nvidia.geforcenow -c 'cd /app/cef && exec ./GeForceNOW'
