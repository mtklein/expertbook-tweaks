#!/usr/bin/python3
import json
import math
import os
import re
import select
import socket
import subprocess
import threading
import time
from datetime import datetime, timezone
from pathlib import Path

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
STATE = STATE_DIR / "ambient-display.json"
WHITE = STATE_DIR / "hdr-sdr-white"            # nits at 100%, from display.lua
GAMMA = STATE_DIR / "hdr-brightness-gamma"     # the level curve's exponent, from display.lua
LEVEL = STATE_DIR / "hdr-brightness"           # "<level 0..1>\n" plus "user <epoch>\n" while a person's choice holds it
GREETER_NITS = Path("/var/lib/expertbook-tweaks/greeter-nits")   # the login screen shows white at this
SOCKET = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "ambient-display.sock"
MONITOR = "eDP-1"

TICK = 1.0               # control loop period while nothing is moving (s)
TICK_MOVING = 0.05       # ... and while a level is on its way somewhere
SETTLE = 4.0             # seconds a manual white point change must be left alone to be learned
COLOR_EVERY = 3          # sensor cycles per colour read (the rest read lux)
SAMPLE = 1.0             # seconds between sensor cycles; every reading wakes the sensor hub

# Brightness
STATUS = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "ambient-display-status.json"
TV_MODE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "tv-mode/active"  # from tv-mode
DEFAULT_POINTS = [(0, 40), (5, 60), (30, 90), (120, 130), (400, 200), (1500, 300)]
TAU_UP = 7.5             # lux smoothing when the room brightens (s)
TAU_DOWN = 30.0          # ... when it darkens
# How a level moves, for brightness and white point alike:
#   whether: it follows a steadied reading of the room and stays put until that
#            asks for a change worth making (START / HOLD_MIRED);
#   how:     through a critically damped second-order follower (class Follower),
#            the fastest response that never overshoots. A move starts gently,
#            is quickest in the middle and eases in, and takes about the same
#            time (SETTLE_*) whatever its size: small ones are too slow to see,
#            large ones are smooth and brief. If the room changes again on the
#            way, the path bends toward the new target without a jerk.
#   unseen:  a change nobody could have watched (the screen was off) is made at once.
# Brightness is followed in ln(nits) and white point in mireds, where equal
# distances are equal visible changes.
TAU_CALM = 20.0          # the steadied room reading automatic brightness follows (s)
START = 0.12             # move only once the target is this far off, in ln(nits): ~12% of the light
SETTLE_BRIGHT = 15.0     # seconds a brightness move takes (to within 2% of the way)
SETTLE_WHITE = 60.0      # ... and a white point move
SEND_LN = 0.003          # smallest brightness change worth sending: 0.3% of the light
SEND_MIRED = 0.3         # smallest white point change worth sending
MIN_PCT, MAX_PCT = 10, 100
STEP_GAP = 0.08          # a key step this soon after the last is the same press (the keys arrive doubled, and repeat at 40 Hz)
WAKE_FLOOR_PCT = 15      # a screen left dimmer than this is raised to it on wake from suspend
# Ownership: after you set a level it's yours until the room's light changes
# this much (log10 lux, ~2x) from when you set it, or HOLD_MAX passes.
HOLD_DECADES = 0.3
HOLD_MAX = 3 * 3600
OFFSET_REACH = 0.5       # decades over which "dimmer/brighter than the curve here" fades out
OFFSET_HALF_LIFE = 1800  # ... and seconds
# Evidence and the fit.
MIN_DWELL = 3.0          # a level kept less than this was passed on the way: not evidence
DWELL_CAP = 2 * 3600
APPROVE_EVERY = 20 * 60  # an untouched stretch of automatic brightness this long is a silent approval
APPROVE_WEIGHT = 0.3     # ... worth this much of an equally long manual choice
# Approvals pile up every hour the laptop is on and all vote for what the model
# already does, so uncapped they'd outvote any correction. At each point of a
# fit their total counts for at most APPROVE_SHARE of the manual evidence
# there (or APPROVE_FLOOR, about one modest choice, where there's little).
APPROVE_SHARE = 0.5
APPROVE_FLOOR = 2.0
HALF_LIFE = 14 * 86400   # evidence weight halves every two weeks
MAX_AGE = 60 * 86400
MAX_EVENTS = 2000
BANDWIDTH = 0.25         # decades of log lux an event informs
CROSS_PHASE = 0.15       # how much daytime evidence counts at night (and vice versa)
GRID = [i / 10 for i in range(46)]   # log10(lux + 1), 0 .. 4.5

# White point
NIGHT_K = 3300
LIT_WARMEST_K = 3400     # the lit-room model never goes warmer than this
NEUTRAL_K = 6600         # gains 1, 1, 1
MARKS_K = [2500, 2700, 3000, 3300, 3700, 4200, 4800, 5600, 6600]   # where the keys stop, ~30 mired apart
MIN_K, MAX_K = MARKS_K[0], MARKS_K[-1]
D65 = 1e6 / 6500
ADAPT = 0.7              # fraction of the ambient-vs-D65 mired offset to follow
TAU = 30.0               # ambient colour smoothing (s)
TAU_LUX = 20.0           # lux smoothing for the white point (s)
NIGHT_LUX = 3.0          # dark fade reaches NIGHT_K at and below this
CUTOFF_LUX = 20.0        # assumed colour cutoff when starting up already dark
DARK_AFTER = 15.0        # seconds of "can't measure" readings before dark
LIT_AFTER = 3.0          # seconds of real readings before lit
RESEND = 30.0            # repeat the white point this often, in case the helper was restarted
HOLD_MIRED = 12          # a move starts only once the target is this far from the screen
CTM = Path.home() / ".local/bin/white-point-ctm"   # the helper that holds Hyprland's colour matrix (ctm/)
# White point learning: evidence like brightness's (dwell, recency, kind above).
WHITE_BANDWIDTH = 0.3    # decades of log lux a white point choice informs
PHASE_SIGMA = 0.35       # nightness (0 day .. 1 night) a choice informs
WHITE_PRIOR = 0.5        # weight of "the plain model is right": thin evidence moves it less
DEFAULT_COLORTEMP_RAW = 4500000   # the "too dark to measure" reading


def L(lux):
    return math.log10(lux + 1.0)


def mired(k):
    return 1e6 / k


def log(msg):
    print(msg, flush=True)


# ---------------------------------------------------------------- state

class Store:
    def __init__(self):
        try:
            self.d = json.loads(STATE.read_text())
        except (OSError, ValueError):
            self.d = {}

    def save(self):
        try:
            STATE.parent.mkdir(parents=True, exist_ok=True)
            tmp = STATE.with_suffix(".tmp")
            tmp.write_text(json.dumps(self.d, indent=1) + "\n")
            tmp.replace(STATE)
        except OSError as e:
            log(f"couldn't save state: {e}")


def interpolate(points, lux, reach=None):
    """Linear in log lux between points. Past the ends: flat, or (with reach)
    fading linearly to 0 over `reach` decades."""
    if not points:
        return 0.0
    x = L(lux)
    xs = [(L(a), b) for a, b in points]
    if x <= xs[0][0]:
        y = xs[0][1]
        return y if reach is None else y * max(0.0, 1 - (xs[0][0] - x) / reach)
    if x >= xs[-1][0]:
        y = xs[-1][1]
        return y if reach is None else y * max(0.0, 1 - (x - xs[-1][0]) / reach)
    for (x0, y0), (x1, y1) in zip(xs, xs[1:]):
        if x0 <= x <= x1:
            return y0 + (y1 - y0) * (x - x0) / (x1 - x0) if x1 > x0 else y1
    return xs[-1][1]


# ---------------------------------------------------------------- sun

def solar_elevation(lat, lon, when=None):
    """Degrees above the horizon (NOAA's approximation; a fraction of a degree)."""
    t = when or datetime.now(timezone.utc)
    day = t.timetuple().tm_yday
    hour = t.hour + t.minute / 60 + t.second / 3600
    g = 2 * math.pi / 365 * (day - 1 + (hour - 12) / 24)
    eqtime = 229.18 * (0.000075 + 0.001868 * math.cos(g) - 0.032077 * math.sin(g)
                       - 0.014615 * math.cos(2 * g) - 0.040849 * math.sin(2 * g))
    decl = (0.006918 - 0.399912 * math.cos(g) + 0.070257 * math.sin(g) - 0.006758 * math.cos(2 * g)
            + 0.000907 * math.sin(2 * g) - 0.002697 * math.cos(3 * g) + 0.00148 * math.sin(3 * g))
    ha = math.radians((hour * 60 + eqtime + 4 * lon) / 4 - 180)
    la = math.radians(lat)
    cos_zenith = math.sin(la) * math.sin(decl) + math.cos(la) * math.cos(decl) * math.cos(ha)
    return 90 - math.degrees(math.acos(max(-1.0, min(1.0, cos_zenith))))


def lookup_location():
    """(lat, lon) from wttr.in's IP lookup, or None."""
    import urllib.request
    try:
        with urllib.request.urlopen("https://wttr.in/?format=j1", timeout=15) as r:
            area = json.load(r)["nearest_area"][0]
        return float(area["latitude"]), float(area["longitude"])
    except (OSError, ValueError, KeyError, IndexError):
        return None


# ---------------------------------------------------------------- sensor

def find_sensor():
    for d in Path("/sys/bus/iio/devices").glob("iio:device*"):
        try:
            if (d / "name").read_text().strip() == "als":
                return d
        except OSError:
            pass
    return None


def sensor_attr(sensor, name, default):
    try:
        return float((sensor / name).read_text())
    except (OSError, ValueError):
        return default


class Sensor(threading.Thread):
    """Samples (time, lux, colortemp raw or None) every SAMPLE seconds."""

    def __init__(self, path):
        super().__init__(daemon=True)
        self.lux_path = path / "in_illuminance_raw"
        self.color_path = path / "in_colortemp_raw"
        self.scale = sensor_attr(path, "in_illuminance_scale", 1.0)
        self.offset = sensor_attr(path, "in_illuminance_offset", 0.0)
        self.lock = threading.Lock()
        self.samples = []

    def run(self):
        n = 0
        while True:
            raw = None
            if n % COLOR_EVERY == 0:
                try:
                    raw = int(self.color_path.read_text())
                except (OSError, ValueError):
                    pass
            n += 1
            try:
                lux = max(0.0, (float(self.lux_path.read_text()) + self.offset) * self.scale)
            except (OSError, ValueError):
                time.sleep(1)
                continue
            with self.lock:
                self.samples.append((time.monotonic(), lux, raw))
            time.sleep(SAMPLE)

    def take(self):
        with self.lock:
            out, self.samples = self.samples, []
        return out


# ---------------------------------------------------------------- hyprland

def hypr_socket():
    run = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if sig:
        return f"{run}/hypr/{sig}/.socket.sock"
    socks = sorted(Path(run, "hypr").glob("*/.socket.sock"), key=lambda p: p.stat().st_mtime)
    return str(socks[-1]) if socks else None


def hypr_json(command):
    """Like `hyprctl -j <command>`, without spawning hyprctl."""
    path = hypr_socket()
    if not path:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(3)
            s.connect(path)
            s.sendall(f"j/{command}".encode())
            data = b""
            while chunk := s.recv(65536):
                data += chunk
        return json.loads(data)
    except (OSError, ValueError):
        return None


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def hypr_eval(lua):
    """Like `hyprctl eval <lua>`, without spawning hyprctl (a move sends ~20 a second)."""
    path = hypr_socket()
    if not path:
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(3)
            s.connect(path)
            s.sendall(f"eval {lua}".encode())
            return s.recv(64).startswith(b"ok")
    except OSError:
        return False


class Follower:
    """A critically damped second-order follower: y'' = w^2 (target - y) - 2 w y'.

    Two first-order lags in series, tuned to the edge of oscillation: the
    quickest path to the target that never overshoots it. From rest, a step
    of any size is covered as 1 - (1 + wt) e^(-wt): 98% of the way at
    wt = 5.83, which is what `settle` (seconds) sets."""

    def __init__(self, settle):
        self.w = 5.83 / settle
        self.y, self.v = None, 0.0

    def reset(self, y):
        self.y, self.v = y, 0.0

    def step(self, target, dt):
        n = max(1, math.ceil(min(dt, 1.0) / 0.01))   # small substeps keep the integration exact enough
        h = min(dt, 1.0) / n
        for _ in range(n):
            self.v += (self.w * self.w * (target - self.y) - 2 * self.w * self.v) * h
            self.y += self.v * h
        return self.y

    def arrived(self, target, eps):
        return abs(target - self.y) < eps and abs(self.v) < eps * self.w


def kelvin_gains(k):
    """Per-channel gains for a colour temperature: the display-encoded sRGB
    colour of that white (Tanner Helland's fit, as hyprsunset uses, but for any
    kelvin rather than hundreds). The patched Hyprland turns these into a
    linear-light white point (hyprland-patched/02)."""
    t = k / 100
    if t <= 66:
        g = min(255.0, max(0.0, 99.4708025861 * math.log(t) - 161.1195681661))
        b = 0.0 if t <= 19 else min(255.0, max(0.0, math.log(t - 10) * 138.5177312231 - 305.0447927307))
        return 1.0, g / 255, b / 255
    r = min(255.0, max(0.0, 329.698727446 * (t - 60) ** -0.1332047592))
    g = min(255.0, max(0.0, 288.1221695283 * (t - 60) ** -0.0755148492))
    return r / 255, g / 255, 1.0


class Ctm:
    """The white-point-ctm helper (ctm/): it holds Hyprland's colour matrix for
    as long as it runs, so it's kept running and restarted if it dies."""

    def __init__(self):
        self.proc = None
        self.retry_at = 0.0

    def lost(self):
        """True once after the helper has died: whatever it held is gone."""
        if self.proc is None or self.proc.poll() is None:
            return False
        now = time.monotonic()
        if self.proc.returncode == 3:            # another client holds the matrix: hyprsunset
            log("white: hyprsunset holds the colour matrix; stopping it")
            run("pkill", "-x", "hyprsunset")
            self.retry_at = now + 0.5
        else:
            log(f"white: helper exited ({self.proc.returncode}); restarting")
            self.retry_at = now + 5
        self.proc = None
        return True

    def send(self, r, g, b):
        now = time.monotonic()
        self.lost()
        if self.proc is None:
            if now < self.retry_at:
                return False
            try:
                self.proc = subprocess.Popen([str(CTM)], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                             stderr=subprocess.DEVNULL)
            except OSError as e:
                log(f"white: can't start {CTM}: {e}")
                self.retry_at = now + 30
                return False
        try:
            self.proc.stdin.write(f"{r:.5f} {g:.5f} {b:.5f}\n".encode())
            self.proc.stdin.flush()
            return True
        except OSError:
            return False


# ---------------------------------------------------------------- brightness

def parse_step(step):
    """"+10%" -> (1, 10), "10%-" -> (-1, 10), "40%" -> (0, 40)."""
    m = re.fullmatch(r"(\+?)(\d+)%(-?)", step)
    if not m or (m[1] and m[3]):
        return None
    return (1 if m[1] else -1 if m[3] else 0), int(m[2])


def stepped(current, sign, n):
    if sign == 0:
        target = n
    elif n in (5, 10):
        target = current // n * n + n if sign > 0 else (current + n - 1) // n * n - n
    else:
        target = current + sign * n
    return min(100, max(0, target))


def hour_now():
    t = time.localtime()
    return t.tm_hour + t.tm_min / 60


def hour_gap(a, b):
    """Hours between two times of day, round the 24 h circle."""
    d = abs(a - b) % 24
    return min(d, 24 - d)


def weighted_median(pairs):
    """pairs: [(value, weight)]."""
    pairs = sorted(pairs)
    half = sum(w for _, w in pairs) / 2
    acc = 0.0
    for v, w in pairs:
        acc += w
        if acc >= half:
            return v
    return pairs[-1][0]


def cap_approvals(items):
    """items: [(value, weight, kind)] -> [(value, weight)], with the approvals'
    total weight scaled down to max(APPROVE_FLOOR, APPROVE_SHARE x the rest)."""
    manual = sum(w for _, w, k in items if k != "approve")
    approve = sum(w for _, w, k in items if k == "approve")
    cap = max(APPROVE_FLOOR, APPROVE_SHARE * manual)
    f = cap / approve if approve > cap else 1.0
    return [(v, w * f if k == "approve" else w) for v, w, k in items]


def isotonic(values, weights):
    """Weighted pool-adjacent-violators: the closest non-decreasing sequence."""
    blocks = []   # [mean, weight, count]
    for v, w in zip(values, weights):
        blocks.append([v, w, 1])
        while len(blocks) > 1 and blocks[-2][0] > blocks[-1][0]:
            v2, w2, c2 = blocks.pop()
            v1, w1, c1 = blocks.pop()
            w = w1 + w2
            blocks.append([(v1 * w1 + v2 * w2) / w if w else (v1 + v2) / 2, w, c1 + c2])
    out = []
    for v, _, c in blocks:
        out += [v] * c
    return out


class Brightness:
    def __init__(self, store):
        self.store = store
        self.events = store.d.setdefault("brightness_events", [])
        self.smooth = None       # smoothed log lux
        self.last_t = None
        self.white = None        # nits at 100%
        self.gamma = 1.0         # level -> nits is white * (level / 100) ** gamma (display.lua)
        self.last_set = None     # the level as last seen or written (%, fractional under automatic control)
        self.calm = None         # steadied log lux: what automatic brightness follows
        self.follow = Follower(SETTLE_BRIGHT)   # in ln(nits)
        self.sent_y = None       # ln(nits) last sent during a move
        self.saved_at = 0.0
        self.last_tick = None
        self.asleep = True       # the screen was off (or we just started): nobody saw the last level
        self.screen_on = False   # as of the last check
        self.owner = "auto"      # "auto" | "user"
        self.hold_x = None       # log lux when the user took over
        self.hold_since = 0.0
        self.open = None         # the user's current choice, not yet closed into evidence
        self.offset = 0.0        # nits the user wanted above/below the curve, carried on release
        self.offset_x = None
        self.offset_t = 0.0
        self.hold_wall = 0.0     # wall time the user took over
        self.woke = False        # resumed from suspend, not yet handled
        self.last_step = 0.0
        self.last_check = 0.0
        self.next_step = 0.0
        self.fading = False
        self.stable_since = None # wall time automatic brightness has sat untouched since
        self.curve = None        # (hour, grid nits) cache
        self.curve_at = 0.0
        self.last_status = 0.0
        self.resume_user_hold()

    # ------------------------------------------------------------ evidence and fit

    def weight(self, e, now, hour):
        dwell = math.log1p(min(e.get("d", 0), DWELL_CAP) / 30.0)
        recency = 0.5 ** (max(0.0, now - e["t"]) / HALF_LIFE)
        kind = APPROVE_WEIGHT if e["k"] == "approve" else 1.0
        h = e.get("h")
        if h is None:
            when = 1.0                          # seeds: any time of day
        else:
            when = max(CROSS_PHASE, math.exp(-0.5 * (hour_gap(h, hour) / 2.0) ** 2))
        return dwell * recency * kind * when

    def fit(self, hour):
        """Grid of nits over GRID (log lux) for this time of day."""
        now = time.time()
        weighted = [(e, self.weight(e, now, hour)) for e in self.events]
        values, weights = [], []
        for c in GRID:
            pairs = []
            for e, w in weighted:
                k = math.exp(-0.5 * ((e["x"] - c) / BANDWIDTH) ** 2)
                if k * w > 1e-4:
                    pairs.append((e["nits"], k * w, e["k"]))
            pairs = cap_approvals(pairs)
            total = sum(w for _, w in pairs)
            values.append(weighted_median(pairs) if total > 0.02 else None)
            weights.append(total)
        known = [i for i, v in enumerate(values) if v is not None]
        if not known:
            return [interpolate(DEFAULT_POINTS, 10 ** c - 1) for c in GRID]
        for i, v in enumerate(values):          # fill gaps: interpolate, flat past the ends
            if v is None:
                lo = max((j for j in known if j < i), default=None)
                hi = min((j for j in known if j > i), default=None)
                if lo is None: values[i] = values[hi]
                elif hi is None: values[i] = values[lo]
                else: values[i] = values[lo] + (values[hi] - values[lo]) * (i - lo) / (hi - lo)
                weights[i] = 1e-3
        return isotonic(values, weights)

    def model(self, x):
        """Nits the evidence suggests at log lux x, now."""
        hour = hour_now()
        now = time.monotonic()
        if self.curve is None or now - self.curve_at > 600 or hour_gap(self.curve[0], hour) > 0.25:
            self.curve, self.curve_at = (hour, self.fit(hour)), now
        grid = self.curve[1]
        if x <= GRID[0]: return grid[0]
        if x >= GRID[-1]: return grid[-1]
        i = int(x * 10)
        f = x * 10 - i
        return grid[i] + (grid[i + 1] - grid[i]) * f

    def add_event(self, e):
        now = time.time()
        self.events.append(e)
        self.events = [ev for ev in self.events if now - ev["t"] < MAX_AGE][-MAX_EVENTS:]
        self.store.d["brightness_events"] = self.events
        self.store.save()
        self.curve = None

    def close_open(self):
        if not self.open:
            return
        e, self.open = self.open, None
        e["d"] = round(min(time.time() - e["t"], DWELL_CAP), 1)
        if e["d"] < MIN_DWELL:
            return
        self.add_event(e)
        log(f"brightness: kept {e['nits']:.0f} nits at {10 ** e['x'] - 1:.0f} lux, "
            f"{e['h']:.1f} h, for {e['d']:.0f} s")

    # ------------------------------------------------------------ control

    def resume_user_hold(self):
        """After a restart, a recent user change still owns the level."""
        try:
            _, kind, when = LEVEL.read_text().split()[:3]
            held = time.time() - float(when)
            if kind == "user" and held < HOLD_MAX:
                self.owner, self.hold_since, self.hold_wall = "user", time.monotonic() - held, float(when)
        except (OSError, ValueError):
            pass

    def request(self, monitor, step, now):
        """A person's change (keys, bar slider). "elsewhere": not this screen's to handle."""
        parsed = parse_step(step)
        if parsed is None:
            return "elsewhere"
        if monitor == "-":
            monitor = next((m["name"] for m in hypr_json("monitors") or [] if m.get("focused")), None)
        if monitor != MONITOR:
            return "elsewhere"
        current = self.last_set if self.last_set is not None else self.get_pct()
        current = int((100 if current is None else current) + 0.5)
        if parsed[0] != 0:
            if now - self.last_step < STEP_GAP:
                return f"ok {current}"
            self.last_step = now
        pct = stepped(current, *parsed)
        self.user_changed(pct, now)
        self.set_level(pct)
        return f"ok {pct}"

    def feed(self, t, lux):
        x = L(lux)
        if self.smooth is None:
            self.smooth = x
        else:
            tau = TAU_UP if x > self.smooth else TAU_DOWN
            self.smooth += (x - self.smooth) * (1 - math.exp(-(t - self.last_t) / tau))
            self.calm += (x - self.calm) * (1 - math.exp(-(t - self.last_t) / TAU_CALM))
        if self.calm is None:
            self.calm = x
        self.last_t = t

    def edp_state(self):
        m = next((m for m in hypr_json("monitors") or [] if m.get("name") == MONITOR), None)
        if not (m and not m.get("disabled") and m.get("dpmsStatus", True)):
            return None
        return m.get("sdrMaxLuminance") if m.get("colorManagementPreset") == "hdr" else None

    def get_pct(self):
        try:
            return round(float(LEVEL.read_text().split()[0]) * 100, 2)
        except OSError:
            return 100
        except (ValueError, IndexError):
            return None

    def nits_at(self, pct):
        return self.white * (max(pct, 0) / 100) ** self.gamma

    def pct_for(self, nits):
        return 100 * (max(nits, 0.0) / self.white) ** (1 / self.gamma)

    def user_changed(self, pct, now):
        self.close_open()                       # the previous choice, with its dwell
        self.owner, self.hold_x, self.hold_since, self.hold_wall = "user", self.smooth, now, time.time()
        self.last_set, self.fading, self.stable_since, self.offset = pct, False, None, 0.0
        if pct >= MIN_PCT and self.white and self.smooth is not None:
            self.open = {"t": time.time(), "x": round(self.smooth, 3), "h": round(hour_now(), 2),
                         "nits": round(self.nits_at(pct), 1), "k": "user", "d": 0}

    def release(self, now, why):
        self.close_open()
        if self.last_set is not None and self.white and self.hold_x is not None:
            self.offset = self.nits_at(self.last_set) - self.model(self.hold_x)
            self.offset_x, self.offset_t = self.hold_x, now
        self.owner, self.stable_since = "auto", None
        self.save_level()
        log(f"brightness: {why}; automatic again (carrying {self.offset:+.0f} nits)")

    def target_pct(self, now, x=None):
        """The level the evidence asks for at log lux x (default: the calm reading)."""
        x = self.calm if x is None else x
        nits = self.model(x)
        if self.offset and self.offset_x is not None:
            fade = math.exp(-abs(x - self.offset_x) / OFFSET_REACH) \
                * 0.5 ** ((now - self.offset_t) / OFFSET_HALF_LIFE)
            nits += self.offset * fade
        return min(MAX_PCT, max(MIN_PCT, self.pct_for(nits)))

    def save_level(self):
        if self.last_set is None:
            return
        owner = f"user {self.hold_wall:.0f}\n" if self.owner == "user" else ""
        try:
            LEVEL.write_text(f"{self.last_set / 100:.4f}\n{owner}")
            self.saved_at = time.monotonic()
        except OSError:
            pass
        if self.white:
            try:
                GREETER_NITS.write_text(f"{self.nits_at(self.last_set):.1f}\n")
            except OSError:
                pass

    def set_level(self, pct, save=True):
        self.last_set = pct
        applied = hypr_eval(f"edp_hdr_level({pct / 100:.5f})")
        if save or time.monotonic() - self.saved_at >= 0.5:
            self.save_level()
        return applied

    def write_status(self, now, target):
        try:
            STATUS.write_text(json.dumps({
                "time": time.strftime("%H:%M:%S"), "lux": round(10 ** self.smooth - 1, 1),
                "hour": round(hour_now(), 2), "level": self.last_set, "owner": self.owner,
                "target": target, "model_nits": round(self.model(self.smooth), 1), "white": self.white,
                "nits": None if self.last_set is None else round(self.nits_at(self.last_set), 1),
                "hold_lux": None if self.hold_x is None else round(10 ** self.hold_x - 1, 1),
                "offset_nits": round(self.offset, 1), "events": len(self.events),
                "open": self.open}, indent=1) + "\n")
        except OSError:
            pass

    def tick(self, now):
        dt = 0.0 if self.last_tick is None else now - self.last_tick
        self.last_tick = now
        if self.smooth is None:
            return

        if now - self.last_check >= 1.0:
            self.last_check = now
            nits = self.edp_state()
            current = self.get_pct() if nits else None
            self.screen_on = current is not None
            if not self.screen_on:
                self.asleep = True               # screen off: whatever comes next, nobody watches it happen
                return
            try:
                self.gamma = float(GAMMA.read_text())
            except (OSError, ValueError):
                self.gamma = 1.0
            try:
                self.white = float(WHITE.read_text())
            except (OSError, ValueError):
                self.white = nits / (current / 100) ** self.gamma if current else 200.0
            if self.last_set is None:
                self.last_set = current
                self.save_level()
        if not self.screen_on:
            return

        if self.woke:
            self.asleep = True
            if self.last_set is not None and self.last_set < WAKE_FLOOR_PCT:
                was = self.last_set
                self.owner, self.open, self.offset = "auto", None, 0.0
                self.fading, self.stable_since = False, None
                if not self.set_level(WAKE_FLOOR_PCT):
                    self.last_set = was
                    return
                log(f"brightness: woke at {was:.0f}%; raised to {WAKE_FLOOR_PCT}%, automatic again")
            self.woke = False

        if self.owner == "user":
            self.asleep = False                  # your level stays yours across a sleep
            if self.hold_x is None:
                self.hold_x = self.smooth        # resumed after a restart: hold from here
            if self.last_set is not None and self.last_set >= MIN_PCT and self.hold_x is not None:
                if abs(self.smooth - self.hold_x) >= HOLD_DECADES:
                    self.release(now, f"room light changed ({10 ** self.smooth - 1:.0f} lux)")
                elif now - self.hold_since > HOLD_MAX:
                    self.release(now, "held for 3 h")
            if self.owner == "user":
                if now - self.last_status > 2:
                    self.last_status = now
                    self.write_status(now, None)
                return

        if self.last_set is None or not self.white:
            return
        target = self.target_pct(now)
        if now - self.last_status > 2:
            self.last_status = now
            self.write_status(now, round(target, 1))

        # The screen just came on (wake, unlock, login): go straight to what the
        # room asks for now. Nobody saw the old level, so there's nothing to hide.
        if self.asleep:
            self.asleep = False
            self.calm = self.smooth
            target = self.target_pct(now)
            if abs(target - self.last_set) > 0.05:
                log(f"brightness: screen woke; {self.last_set:.0f}% -> {target:.0f}% at once")
                self.set_level(target)
            self.fading, self.stable_since = False, None
            return

        # Distance to the target in ln(nits): the same number is the same visible change at any level.
        ln = lambda pct: math.log(max(self.nits_at(pct), 0.05))
        goal = ln(target)
        if not self.fading and abs(goal - ln(self.last_set)) >= START:
            self.fading, self.stable_since = True, None
            self.follow.reset(ln(self.last_set))
            self.sent_y = self.follow.y
            log(f"brightness: moving {self.last_set:.0f}% -> {target:.0f}% ({10 ** self.calm - 1:.0f} lux)")
        if self.fading:
            y = self.follow.step(goal, dt)
            done = self.follow.arrived(goal, SEND_LN)
            if done:
                y = goal
            if done or abs(y - self.sent_y) >= SEND_LN:
                self.sent_y = y
                self.set_level(min(MAX_PCT, max(MIN_PCT, self.pct_for(math.exp(y)))), save=done)
            self.fading = not done
            return
        # Untouched automatic brightness is a (weak) approval of it.
        wall = time.time()
        if self.stable_since is None:
            self.stable_since = wall
        elif wall - self.stable_since >= APPROVE_EVERY:
            self.stable_since = wall
            self.add_event({"t": wall, "x": round(self.smooth, 3), "h": round(hour_now(), 2),
                            "nits": round(self.nits_at(self.last_set), 1), "k": "approve",
                            "d": APPROVE_EVERY})


# ---------------------------------------------------------------- white point

class WhitePoint:
    def __init__(self, store):
        self.store = store
        self.neutral, self.night = mired(NEUTRAL_K), mired(NIGHT_K)
        self.lit_warmest = mired(LIT_WARMEST_K)
        self.lo, self.hi = mired(MAX_K), mired(MIN_K)
        self.night_lo = L(NIGHT_LUX)
        loc = store.d.get("location")
        self.location = (loc["lat"], loc["lon"]) if loc else None
        self.events = store.d.setdefault("white_events", [])
        self.fit_key, self.fit_at, self.fit = None, 0.0, 0.0
        if self.location is None:
            threading.Thread(target=self.find_location, daemon=True).start()
        fade = store.d.get("dark_fade") or {}
        self.lit_target = fade.get("lit_mired")      # dark fade starts here (mired) ...
        self.fade_hi = fade.get("cutoff_loglux")     # ... at this log lux (colour lost)
        self.saved_fade = (self.lit_target, self.fade_hi)
        self.last_fade_save = 0.0
        self.ambient = None      # smoothed ambient mired while lit
        self.loglux = None       # smoothed log lux
        self.last_t = None
        self.last_color_t = None
        self.dark = None
        self.default_since = None
        self.real_since = None
        self.current = None      # mired value on screen (as last set)
        self.sent = None         # kelvin last sent
        self.last_send = 0.0
        self.gliding = False     # moving toward the target (vs holding still)
        self.hold = None         # the user's choice while it owns the screen (see tick)
        self.ctm = Ctm()
        self.follow = Follower(SETTLE_WHITE)     # in mireds
        self.sent_mired = None   # what the helper was last given
        self.asleep = True       # the screen was off (or we just started): nobody saw the last white
        self.send_ok = False
        self.stable_since = None # automatic white untouched since (for silent approvals)
        self.last_step = 0.0
        saved = store.d.get("white_hold")
        if saved and time.time() - saved["t"] < HOLD_MAX:
            self.hold = {"value": mired(saved["k"]), "since": time.monotonic() - (time.time() - saved["t"]),
                         "x": saved.get("x"), "event": None}
            if "m" in saved:     # already settled: measured against the model back then
                self.hold["event"] = {"t": saved["t"], "x": saved["x"], "n": saved["n"], "m": saved["m"], "k": "manual"}
            self.current, self.sent = mired(saved["k"]), saved["k"]
        elif saved:
            # Too old to resume. If it had settled, it still counts, for a
            # modest minute: how long it was really on screen isn't known.
            if "m" in saved:
                self.add_event({"t": saved["t"], "x": saved["x"], "n": saved["n"], "m": saved["m"],
                                "k": "manual", "d": 60.0})
            store.d.pop("white_hold", None)
            store.save()
        if store.d.pop("white_manual_seen", None) is not None:
            store.save()

    def request(self, arg, now):
        """A person's change (Shift + brightness keys): "warmer", "cooler", kelvin, or "" to ask."""
        if TV_MODE.exists() or not isinstance(self.sent, int):
            return "err no white point on screen"
        if arg in ("warmer", "cooler") and now - self.last_step < STEP_GAP:
            arg = ""
        elif arg in ("warmer", "cooler"):
            self.last_step = now
        if arg == "":
            k = self.sent
        elif arg == "cooler":
            k = next((m for m in MARKS_K if m > self.sent), MAX_K)
        elif arg == "warmer":
            k = next((m for m in reversed(MARKS_K) if m < self.sent), MIN_K)
        elif arg.isdigit():
            k = min(MAX_K, max(MIN_K, (int(arg) + 50) // 100 * 100))
        else:
            return "err usage: white-point [warmer | cooler | kelvin]"
        if arg != "":
            if self.hold:
                self.release(now, "changed again")
            self.hold = {"value": mired(k), "since": now, "x": self.loglux, "event": None}
            self.store.d["white_hold"] = {"k": k, "t": round(time.time(), 1),
                                          "x": None if self.loglux is None else round(self.loglux, 3)}
            self.current, self.gliding = mired(k), False
            self.store.save()
        meter = (mired(MIN_K) - mired(k)) / (mired(MIN_K) - mired(MAX_K)) * 100
        return f"ok {k} {meter:.0f}"

    def feed(self, t, lux, raw):
        x = L(lux)
        a = None if self.last_t is None else 1 - math.exp(-(t - self.last_t) / TAU_LUX)
        self.loglux = x if a is None else self.loglux + (x - self.loglux) * a
        if raw is not None:
            if raw == DEFAULT_COLORTEMP_RAW:
                self.default_since = self.default_since or t
                self.real_since = None
            else:
                self.real_since = self.real_since or t
                self.default_since = None
                amb = mired(max(raw, 1000000) / 1000.0)
                if self.ambient is None or self.last_color_t is None:
                    self.ambient = amb
                else:
                    self.ambient += (amb - self.ambient) * (1 - math.exp(-(t - self.last_color_t) / TAU))
                self.fade_hi = self.loglux
            self.last_color_t = t
        self.last_t = t

    def model(self):
        """The plain model's target (mired), before learned corrections."""
        if self.dark:
            start = self.lit_target if self.lit_target is not None else self.lit_warmest
            hi = self.fade_hi if self.fade_hi is not None else L(CUTOFF_LUX)
            if self.loglux is None or hi - self.night_lo < 0.05:
                f = 1.0
            else:
                f = min(1.0, max(0.0, (hi - self.loglux) / (hi - self.night_lo)))
            return self.night if f >= 1.0 else start + f * (self.night - start)
        if self.ambient is not None:
            t = min(max(self.neutral + ADAPT * (self.ambient - D65), self.neutral), self.lit_warmest)
            self.lit_target = t
            return t
        return None

    def find_location(self):
        for wait in (0, 60, 300, 1800):
            time.sleep(wait)
            loc = lookup_location()
            if loc:
                self.location = loc
                self.store.d["location"] = {"lat": loc[0], "lon": loc[1]}
                self.store.save()
                log(f"white: location {loc[0]:.2f}, {loc[1]:.2f}")
                return

    def nightness(self):
        """0 = day, 1 = night, in between through civil twilight."""
        if self.location:
            elev = solar_elevation(*self.location)
            return min(1.0, max(0.0, (6 - elev) / 12))
        return 0.0 if 7 <= time.localtime().tm_hour < 18 else 1.0

    # ------------------------------------------------------------ evidence

    def weight(self, e, now):
        dwell = math.log1p(min(e.get("d", 0), DWELL_CAP) / 30.0)
        recency = 0.5 ** (max(0.0, now - e["t"]) / HALF_LIFE)
        return dwell * recency * (APPROVE_WEIGHT if e["k"] == "approve" else 1.0)

    def correction(self):
        """Learned mired correction at the current lux and nightness: the
        weighted median of nearby choices (by closeness in log lux and in
        nightness, how long each was kept, recency), shrunk toward the plain
        model by WHITE_PRIOR so thin evidence moves it less. A brief odd choice
        is one small weight among many and can't decide the result."""
        if self.loglux is None:
            return 0.0
        x, n = self.loglux, self.nightness()
        key = (round(x, 2), round(n, 2), len(self.events), self.events[-1]["t"] if self.events else 0)
        now = time.monotonic()
        if key == self.fit_key and now - self.fit_at < 60:
            return self.fit
        wall = time.time()
        pairs = []
        for e in self.events:
            w = (self.weight(e, wall) * math.exp(-0.5 * ((e["x"] - x) / WHITE_BANDWIDTH) ** 2)
                 * max(CROSS_PHASE, math.exp(-0.5 * ((e["n"] - n) / PHASE_SIGMA) ** 2)))
            if w > 1e-4:
                pairs.append((e["m"], w, e["k"]))
        pairs = cap_approvals(pairs)
        total = sum(w for _, w in pairs)
        self.fit = weighted_median(pairs) * total / (total + WHITE_PRIOR) if pairs else 0.0
        self.fit_key, self.fit_at = key, now
        return self.fit

    def add_event(self, e):
        now = time.time()
        self.events.append(e)
        self.events = [ev for ev in self.events if now - ev["t"] < MAX_AGE][-MAX_EVENTS:]
        self.store.d["white_events"] = self.events
        self.store.save()
        self.fit_key = None

    def release(self, now, why):
        """The user's choice stops owning the screen; it becomes evidence,
        weighted by how long it was kept."""
        h, self.hold = self.hold, None
        self.stable_since = None
        if self.store.d.pop("white_hold", None) is not None:
            self.store.save()
        if not h or h["event"] is None:     # changed again before it settled: passed through
            return
        e = h["event"]
        e["d"] = round(min(now - h["since"], DWELL_CAP), 1)
        if e["d"] < MIN_DWELL:
            return
        self.add_event(e)
        log(f"white: kept {round(1e6 / h['value'])}K at {10 ** e['x'] - 1:.0f} lux, night {e['n']:.2f}, "
            f"{e['m']:+.1f} mired vs model, for {e['d']:.0f} s ({why})")

    def send(self, k):
        """k: kelvin, or None for no white point at all (TV mode)."""
        self.send_ok = self.ctm.send(*(kelvin_gains(k) if k else (1.0, 1.0, 1.0)))
        return self.send_ok

    def tick(self, now, dt, screen_on=True):
        if self.ctm.lost():
            self.sent_mired = None               # send again as soon as it's back
        if not screen_on:
            self.asleep = True
        was_dark = self.dark
        if self.default_since is not None and (self.dark is None or now - self.default_since >= DARK_AFTER):
            self.dark = True
        elif self.real_since is not None and (self.dark is None or now - self.real_since >= LIT_AFTER):
            self.dark = False
        if was_dark is not None and self.dark != was_dark:
            log(f"white: room is now {'dark' if self.dark else 'lit'}")

        if (self.lit_target is not None and self.fade_hi is not None and now - self.last_fade_save >= 60
                and (self.saved_fade[0] is None or self.saved_fade[1] is None
                     or abs(self.lit_target - self.saved_fade[0]) >= 1
                     or abs(self.fade_hi - self.saved_fade[1]) >= 0.02)):
            self.store.d["dark_fade"] = {"lit_mired": round(self.lit_target, 2),
                                         "cutoff_loglux": round(self.fade_hi, 3)}
            self.store.save()
            self.saved_fade, self.last_fade_save = (self.lit_target, self.fade_hi), now

        if TV_MODE.exists():
            if self.hold:
                self.release(now, "TV mode")
            self.current, self.gliding = None, False
            if (self.sent != "tv" or now - self.last_send >= RESEND) and self.send(None):
                if self.sent != "tv":
                    log("white: identity for TV mode")
                self.sent, self.last_send = "tv", now
            return

        base = self.model()
        if self.hold:
            h = self.hold
            if h["event"] is None and now - h["since"] >= SETTLE and base is not None and self.loglux is not None:
                h["x"] = self.loglux if h["x"] is None else h["x"]
                h["event"] = {"t": round(time.time() - (now - h["since"]), 1), "x": round(h["x"], 3),
                              "n": round(self.nightness(), 2), "m": round(h["value"] - base, 1), "k": "manual"}
                self.store.d.get("white_hold", {}).update(x=h["event"]["x"], n=h["event"]["n"], m=h["event"]["m"])
                self.store.save()
                log(f"white: holding {round(1e6 / h['value'])}K at {10 ** h['x'] - 1:.0f} lux, "
                    f"night {h['event']['n']:.2f} ({h['event']['m']:+.1f} mired vs model {round(1e6 / base)}K)")
            why = None
            if was_dark is not None and self.dark != was_dark:
                why = "room turned " + ("dark" if self.dark else "lit")
            elif h["x"] is not None and self.loglux is not None and abs(self.loglux - h["x"]) >= HOLD_DECADES:
                why = "room light changed"
            elif now - h["since"] >= HOLD_MAX:
                why = "held long enough"
            if why:
                self.release(now, why)

        if self.hold:
            target = self.hold["value"]
        elif base is not None:
            target = min(self.hi, max(self.lo, base + self.correction()))
        else:
            target = None

        # Silent approval: automatic white left untouched (and actually on
        # screen) for APPROVE_EVERY is weak evidence that it's right here.
        if (target is not None and base is not None and self.loglux is not None and not self.hold
                and not self.gliding and self.send_ok):
            if self.stable_since is None:
                self.stable_since = now
            elif now - self.stable_since >= APPROVE_EVERY:
                self.stable_since = now
                self.add_event({"t": round(time.time(), 1), "x": round(self.loglux, 3), "n": round(self.nightness(), 2),
                                "m": round(target - base, 1), "k": "approve", "d": APPROVE_EVERY})
        else:
            self.stable_since = None

        jump = False
        if target is not None:
            if self.current is None or (self.asleep and screen_on):
                # First value, or the screen just came on: nobody is
                # watching a transition, so there isn't one.
                self.current, jump, self.gliding = target, True, False
            elif not self.gliding and abs(target - self.current) >= HOLD_MIRED:
                self.gliding = True
                self.follow.reset(self.current)
                lux = f", {10 ** self.loglux - 1:.0f} lux" if self.loglux is not None else ""
                why = ("dark" if self.dark else "lit") + lux
                log(f"white: moving {round(1e6 / self.current)}K -> {round(1e6 / target)}K ({why})")
            if self.gliding:
                self.current = self.follow.step(target, dt)
                if self.follow.arrived(target, SEND_MIRED):
                    self.current, self.gliding = target, False
        if screen_on:
            self.asleep = False
        if self.current is None:
            return

        self.current = min(self.hi, max(self.lo, self.current))
        if (self.sent_mired is None or self.sent == "tv" or abs(self.current - self.sent_mired) >= SEND_MIRED
                or (not self.gliding and self.current != self.sent_mired) or now - self.last_send >= RESEND):
            value = 1e6 / self.current
            if self.send(value):
                if jump:
                    log(f"white: -> {round(value)}K")
                self.sent, self.sent_mired, self.last_send = round(value), self.current, now


# ---------------------------------------------------------------- main

def serve(listener, brightness, white, now):
    try:
        conn, _ = listener.accept()
    except OSError:
        return
    with conn:
        conn.settimeout(0.5)
        try:
            words = conn.makefile().readline().split()
            if len(words) == 3 and words[0] == "brightness":
                reply = brightness.request(words[1], words[2], now)
            elif words and words[0] == "white" and len(words) <= 2:
                reply = white.request(words[1] if len(words) == 2 else "", now)
            else:
                reply = "err unknown request"
            conn.sendall(f"{reply}\n".encode())
        except OSError:
            pass


def suspended_seconds():
    return time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()


def main():
    path = find_sensor()
    if path is None:
        raise SystemExit("no iio 'als' sensor found")
    store = Store()
    brightness = Brightness(store)
    white = WhitePoint(store)

    SOCKET.unlink(missing_ok=True)
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    listener.bind(str(SOCKET))
    listener.listen(8)
    listener.setblocking(False)

    sensor = Sensor(path)
    sensor.start()
    prev = time.monotonic()
    slept = suspended_seconds()
    while True:
        now = time.monotonic()
        dt, prev = now - prev, now
        if suspended_seconds() - slept > 5:
            slept, brightness.woke = suspended_seconds(), True
        for t, lux, raw in sensor.take():
            brightness.feed(t, lux)
            white.feed(t, lux, raw)
        brightness.tick(now)
        white.tick(now, dt, brightness.screen_on)
        if select.select([listener], [], [], TICK_MOVING if brightness.fading or white.gliding else TICK)[0]:
            serve(listener, brightness, white, time.monotonic())


if __name__ == "__main__":
    main()
