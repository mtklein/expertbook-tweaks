#!/usr/bin/python3
"""TV mode: plug into a 1080p TV while on power and the laptop turns into a
console. The TV becomes the only screen (1080p, sRGB), Steam Big Picture opens
on it, sound goes to the TV, the power profile goes to Performance and nothing
idles, locks or sleeps. Unplug the TV or the charger and everything goes back.

Usage:
  tv-mode watch            the daemon (tv-mode.service) that does all of this
  tv-mode status           what it sees and whether TV mode is on
  tv-mode off              leave TV mode while still docked (until the next dock)
  tv-mode on               undo that: TV mode again, if a TV and power are there
  tv-mode sim plug|unplug  pretend a 1080p TV is connected (a headless output)
  tv-mode sim ac on|off|real   pretend the charger is (un)plugged, or stop pretending
  tv-mode sim dry on|off   in simulation, only log what would black out the
                           laptop screen, move sound or open Big Picture

A "1080p TV" is any external display whose largest mode is 1920x1080. Big
Picture's window is left fullscreen and focused, so a controller drives it from
the first button press.

Pieces elsewhere:
  hypr/tv-mode.lua   re-applies the TV's monitor rule (and the hidden cursor)
                     on config reloads; loaded from ~/.config/hypr/monitors.lua
  ambient-display    holds a neutral white point while $RUN/active exists (the
                     panel's own brightness pauses by itself while it's off)
  Omarchy            its internal-monitor-disable toggle keeps the panel off,
                     its clamshell logic and lid inhibitor handle the closed
                     lid, and its per-monitor workspaces move workspaces to the
                     TV and back
"""
import json
import os
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

RUN = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "tv-mode"
TV_RULE = RUN / "tv"            # "<connector> <mode>": hypr/tv-mode.lua applies it
ACTIVE = RUN / "active"         # JSON: what TV mode changed, to put back
SUPPRESS = RUN / "suppressed"   # `tv-mode off` while docked; cleared on undock
SIM = RUN / "sim.json"          # simulation: {"ac": bool|None, "dry": bool}
LUA = Path.home() / ".config/hypr/tv-mode.lua"
PANEL_OFF_FLAG = Path.home() / ".local/state/omarchy/toggles/hypr/internal-monitor-disable.lua"
INTERNAL = "eDP-1"
SIM_OUTPUT = "TVSIM"
TV_SIZE = (1920, 1080)

ON_AFTER = 2.0       # s the TV and power must both be there before TV mode starts
OFF_AFTER = 3.0      # s without power before it ends (docks renegotiate power on plug)
POLL = 1.0           # s between checks (Hyprland events wake it sooner)
BP_WAIT = 90         # s to wait for Big Picture's window (a cold Steam start is slow)
BP_TITLE = "Steam Big Picture Mode"


def log(msg):
    print(msg, flush=True)


def run(*cmd, quiet=True, timeout=10):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        if r.returncode != 0 and not quiet:
            log(f"{cmd[0]} failed: {r.stderr.strip() or r.stdout.strip()}")
        return r.stdout if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError) as e:
        if not quiet:
            log(f"{cmd[0]} failed: {e}")
        return None


def hypr_json(what):
    out = run("hyprctl", "-j", *what.split())
    try:
        return json.loads(out) if out else None
    except ValueError:
        return None


def hypr_eval(lua):
    return run("hyprctl", "eval", lua, quiet=False) is not None


def hypr_dispatch(lua):
    return run("hyprctl", "dispatch", lua, quiet=False) is not None


def read_json(path, default=None):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def write_json(path, value):
    RUN.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(value) + "\n")
    tmp.replace(path)


def sim():
    return read_json(SIM, {})


# ---------------------------------------------------------------- what's there

def ac_online():
    s = sim().get("ac")
    if s is not None:
        return s
    for p in Path("/sys/class/power_supply").iterdir():
        try:
            if (p / "type").read_text().strip() in ("Mains", "USB") and (p / "online").read_text().strip() == "1":
                return True
        except OSError:
            pass
    return False


def parse_mode(m):
    """'1920x1080@60.00Hz' -> (1920, 1080, 60.0)"""
    try:
        size, hz = m.split("@")
        w, h = size.split("x")
        return int(w), int(h), float(hz.rstrip("Hz"))
    except ValueError:
        return None


def find_tv(monitors=None):
    """The connected 1080p TV as (connector, mode string), or None."""
    monitors = hypr_json("monitors all") if monitors is None else monitors
    simulating = SIM_OUTPUT in {m.get("name") for m in monitors or []}
    for m in monitors or []:
        name = m.get("name", "")
        if name.startswith(("eDP", "LVDS", "DSI")) or name == "FALLBACK":
            continue
        if simulating and name != SIM_OUTPUT:
            continue                  # while simulating, only the simulated TV counts
        if name.startswith("HEADLESS") and name != SIM_OUTPUT:
            continue
        modes = [x for x in map(parse_mode, m.get("availableModes") or []) if x]
        if not modes:
            continue
        biggest = max(w * h for w, h, _ in modes)
        if biggest != TV_SIZE[0] * TV_SIZE[1]:
            continue
        hz = max(r for w, h, r in modes if (w, h) == TV_SIZE)
        return name, f"{TV_SIZE[0]}x{TV_SIZE[1]}@{hz:.2f}"
    return None


# ---------------------------------------------------------------- the pieces

def apply_tv_rule(tv):
    """1080p, scale 1, sRGB, 8 bit, whether or not TV mode is on: the default
    rule's scale 2 would make it a 960x540 desktop."""
    line = f"{tv[0]} {tv[1]}\n"
    try:
        if TV_RULE.read_text() == line:
            return
    except OSError:
        pass
    RUN.mkdir(parents=True, exist_ok=True)
    TV_RULE.write_text(line)
    hypr_eval(f'dofile("{LUA}")')
    log(f"{tv[0]}: {tv[1]}, sRGB")


def drop_tv_rule():
    try:
        TV_RULE.unlink()
        log("TV gone")
    except OSError:
        pass


def panel(on, saved):
    if on:
        if saved.get("made_flag"):
            PANEL_OFF_FLAG.unlink(missing_ok=True)
        try:
            level = float((Path.home() / ".local/state/hdr-brightness").read_text())
        except (OSError, ValueError):
            level = 1.0
        hypr_eval(f'hl.monitor({{ output = "{INTERNAL}", disabled = false }}) edp_hdr_monitor({level})')
        hypr_dispatch(f'hl.dsp.dpms({{ action = "on", monitor = "{INTERNAL}" }})')
    else:
        # Omarchy's own "laptop display off" toggle: its clamshell poll and
        # config reloads respect it, and its unplug recovery clears it.
        saved["made_flag"] = not PANEL_OFF_FLAG.exists()
        if saved["made_flag"]:
            PANEL_OFF_FLAG.parent.mkdir(parents=True, exist_ok=True)
            PANEL_OFF_FLAG.write_text(f'hl.monitor({{ output = "{INTERNAL}", disabled = true }})\n')
        hypr_eval(f'hl.monitor({{ output = "{INTERNAL}", disabled = true }})')


def sinks():
    out = run("pactl", "--format=json", "list", "sinks")
    try:
        return json.loads(out) if out else []
    except ValueError:
        return []


def tv_sink():
    for s in sinks():
        if not is_tv_sink(s.get("name")):
            continue
        port = next((p for p in s.get("ports", []) if p.get("name") == s.get("active_port")), None)
        if port and port.get("availability") != "not available":
            return s["name"]
    return None


def is_tv_sink(name):
    return "hdmi" in (name or "").lower()


def restore_sink(saved):
    """Where sound goes after TV mode: what it was before, unless that was a
    TV/HDMI output (left over from an earlier dock), then the laptop's own."""
    names = [x.get("name") for x in sinks()]
    if saved in names and not is_tv_sink(saved):
        return saved
    return next((n for n in names if n and not is_tv_sink(n)), None)


def default_sink():
    out = run("pactl", "get-default-sink")
    return out.strip() if out else None


def set_sink(name):
    return run("pactl", "set-default-sink", name, quiet=False) is not None


def profile():
    out = run("powerprofilesctl", "get")
    return out.strip() if out else None


def cursor_timeout():
    out = run("hyprctl", "getoption", "cursor:inactive_timeout")
    try:
        return float(out.split()[1]) if out else 0.0
    except (IndexError, ValueError):
        return 0.0


def big_picture_window():
    for c in hypr_json("clients") or []:
        if c.get("class") == "steam" and c.get("title") == BP_TITLE:
            return c
    return None


def show_big_picture(w, tv):
    """Big Picture fullscreen on the TV with focus, so the controller drives it.
    It fullscreens itself, but onto whichever screen Steam last used."""
    addr = f'address:{w["address"]}'
    mon = next((m for m in hypr_json("monitors") or [] if m.get("name") == tv), None)
    ws = mon and mon["activeWorkspace"]["id"]
    if ws is not None and w["workspace"]["id"] != ws:
        if w.get("fullscreen"):
            hypr_dispatch(f'hl.dsp.window.fullscreen({{ mode = "fullscreen", action = "unset", window = "{addr}" }})')
        hypr_dispatch(f'hl.dsp.window.move({{ window = "{addr}", workspace = "{ws}", follow = true }})')
        w = big_picture_window() or w
    hypr_dispatch(f'hl.dsp.focus({{ window = "{addr}" }})')
    if not w.get("fullscreen"):
        hypr_dispatch(f'hl.dsp.window.fullscreen({{ mode = "fullscreen", action = "set", window = "{addr}" }})')


def steam_running():
    return run("pgrep", "-x", "steam") is not None


def open_big_picture():
    subprocess.Popen(["uwsm-app", "--", "steam", "steam://open/bigpicture"],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


class Inhibitor:
    """Holds systemd's idle inhibitor, which hypridle honours: no screen-off or
    suspend while it's held. Dies with tv-mode, so it can't leak."""

    def __init__(self):
        self.proc = None

    def hold(self):
        if self.proc is None or self.proc.poll() is not None:
            self.proc = subprocess.Popen(
                ["systemd-inhibit", "--what=idle", "--who=tv-mode", "--why=TV mode",
                 "--mode=block", "sleep", "infinity"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def release(self):
        if self.proc is not None:
            self.proc.terminate()
            try:
                self.proc.wait(5)
            except subprocess.TimeoutExpired:
                self.proc.kill()
            self.proc = None


# ---------------------------------------------------------------- on and off

class TVMode:
    def __init__(self):
        self.inhibitor = Inhibitor()
        self.saved = read_json(ACTIVE)          # survives a restart of the daemon
        self.want_since = None
        self.unwant_since = None
        self.bp_deadline = None                 # waiting for Big Picture's window until then
        self.audio_deadline = None              # waiting for the TV's sound output until then
        if self.saved:
            self.inhibitor.hold()

    def dry(self):
        return bool(sim().get("dry", True)) and SIM_OUTPUT in (self.saved or {}).get("tv", ["", ""])[0]

    def start(self, tv):
        log(f"TV mode on ({tv[0]})")
        s = {"tv": list(tv), "t": time.time()}
        self.saved = s
        s["profile"] = profile()
        s["sink"] = default_sink()
        s["cursor"] = cursor_timeout()
        dry = s["dry"] = self.dry()
        write_json(ACTIVE, s)                    # ambient-display goes neutral from here
        hypr_eval(f'dofile("{LUA}")')            # hidden cursor (tv-mode.lua reads ACTIVE)
        if dry:
            log("  dry run: would turn the laptop panel off and focus the TV")
        else:
            panel(False, s)
            hypr_dispatch(f'hl.dsp.focus({{ monitor = "{tv[0]}" }})')
        if s["profile"] != "performance":
            run("powerprofilesctl", "set", "performance", quiet=False)
        self.inhibitor.hold()
        self.audio_deadline = time.monotonic() + 15   # the TV's sound appears a moment after its picture
        self.bp_deadline = time.monotonic() + BP_WAIT
        if dry:
            log("  dry run: would open Big Picture")
        else:
            open_big_picture()
        write_json(ACTIVE, s)
        self.service()

    def service(self):
        """Steps that finish after start(): the TV's audio and Big Picture's window."""
        s, now = self.saved, time.monotonic()
        if not s:
            return
        if self.audio_deadline is not None:
            sink = tv_sink()
            if sink or now > self.audio_deadline:
                self.audio_deadline = None
                if not sink:
                    log("  no TV sound output turned up; sound stays where it was")
                elif self.dry():
                    log(f"  dry run: would send sound to {sink}")
                elif set_sink(sink):
                    s["tv_sink"] = sink
                    write_json(ACTIVE, s)
                    log(f"  sound -> {sink}")
        if self.bp_deadline is not None:
            w = big_picture_window()
            if w or now > self.bp_deadline:
                self.bp_deadline = None
                if not w:
                    if not self.dry():
                        log("  Big Picture's window didn't appear")
                    return
                show_big_picture(w, s["tv"][0])
                log("  Big Picture up")

    def stop(self, why):
        s = self.saved
        if not s:
            return
        log(f"TV mode off ({why})")
        dry = self.dry()
        self.bp_deadline = self.audio_deadline = None
        if not dry:
            if big_picture_window() and steam_running():
                subprocess.Popen(["steam", "steam://close/bigpicture"], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            panel(True, s)
            hypr_dispatch(f'hl.dsp.focus({{ monitor = "{INTERNAL}" }})')
        # Always set it, even if PipeWire already fell back to the speakers on
        # unplug: otherwise the TV stays the *configured* default and grabs
        # the sound again the moment it's next plugged in.
        back = restore_sink(s.get("sink"))
        if back and not dry:
            set_sink(back)
        if s.get("profile") and s["profile"] != profile():
            run("powerprofilesctl", "set", s["profile"], quiet=False)
        self.inhibitor.release()
        ACTIVE.unlink(missing_ok=True)
        hypr_eval(f'hl.config({{ cursor = {{ inactive_timeout = {s.get("cursor", 0)} }} }})')
        self.saved = None

    def step(self, tv):
        ac = ac_online()
        if tv:
            apply_tv_rule(tv)
        else:
            drop_tv_rule()
        if not (tv and ac):
            SUPPRESS.unlink(missing_ok=True)    # undocked: `tv-mode off` is used up
        want = bool(tv and ac) and not SUPPRESS.exists()
        now = time.monotonic()

        if self.saved:
            if not tv or tv[0] != self.saved["tv"][0]:
                self.stop("TV unplugged")       # at once: nothing else is showing a picture
            elif not want:
                self.unwant_since = self.unwant_since or now
                if SUPPRESS.exists() or now - self.unwant_since >= OFF_AFTER:
                    self.stop("asked" if SUPPRESS.exists() else "power unplugged")
            else:
                self.unwant_since = None
                self.service()
            self.want_since = None
        elif want:
            self.want_since = self.want_since or now
            if now - self.want_since >= ON_AFTER:
                self.want_since = None
                self.start(tv)
        else:
            self.want_since = None


def events():
    """A socket that becomes readable on Hyprland events, or None."""
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        return None
    path = Path(os.environ.get("XDG_RUNTIME_DIR", "")) / "hypr" / sig / ".socket2.sock"
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(str(path))
        s.setblocking(False)
        return s
    except OSError:
        return None


def outputs_signature():
    """Changes whenever a display is plugged or unplugged, or the simulation
    changes: sysfs connector states (read in-process, no probe) and SIM."""
    sig = []
    try:
        for c in sorted(Path("/sys/class/drm").glob("card*-*")):
            try:
                sig.append((c.name, (c / "status").read_text().strip()))
            except OSError:
                pass
        sig.append(SIM.stat().st_mtime_ns)
    except OSError:
        pass
    return sig


def watch():
    import selectors
    mode = TVMode()
    # Asking Hyprland for its monitors costs a process each time, so only do
    # it when something about the outputs may have changed (a connector's
    # state, the simulation, a Hyprland monitor event or reload) and while TV
    # mode is on or about to be. Otherwise a check is a few sysfs reads.
    tv, seen, dirty = None, None, True
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    sel = selectors.DefaultSelector()
    sock = None
    try:
        while True:
            if sock is None:
                sock = events()
                if sock:
                    sel.register(sock, selectors.EVENT_READ)
            sig = outputs_signature()
            if dirty or sig != seen or mode.saved or mode.want_since:
                tv, seen, dirty = find_tv(), sig, False
            mode.step(tv)
            for key, _ in sel.select(POLL):
                try:
                    data = key.fileobj.recv(65536)
                except BlockingIOError:
                    continue
                if b"monitor" in data or b"configreloaded" in data:
                    dirty = True
                if not data:                      # Hyprland went away
                    dirty = True
                    sel.unregister(sock)
                    sock.close()
                    sock = None
                    time.sleep(POLL)
    finally:
        mode.stop("tv-mode stopped")


# ---------------------------------------------------------------- commands

def status():
    tv, ac, s = find_tv(), ac_online(), read_json(ACTIVE)
    simulating = sim()
    print(f"TV: {f'{tv[0]} ({tv[1]})' if tv else 'none'}; power: {'yes' if ac else 'no'}"
          + (f"  [simulating: {simulating}]" if simulating else ""))
    if s:
        print(f"TV mode on since {time.strftime('%H:%M', time.localtime(s['t']))}"
              f" (will restore: profile {s.get('profile')}, sound {s.get('sink')})")
    elif SUPPRESS.exists():
        print("TV mode off until the next dock (tv-mode on to resume)")
    else:
        print("TV mode off")


def simulate(args):
    s = sim()
    if args[:1] == ["plug"]:
        if not any(m.get("name") == SIM_OUTPUT for m in hypr_json("monitors all") or []):
            run("hyprctl", "output", "create", "headless", SIM_OUTPUT, quiet=False)
            time.sleep(0.5)
            # Off to the right where the mouse can't stray onto it.
            hypr_eval(f'hl.monitor({{ output = "{SIM_OUTPUT}", mode = "1920x1080@60", position = "20000x0", scale = 1 }})')
        s.setdefault("dry", True)
    elif args[:1] == ["unplug"]:
        hypr_eval(f'hl.monitor({{ output = "{SIM_OUTPUT}", disabled = false }})')
        run("hyprctl", "output", "remove", SIM_OUTPUT, quiet=False)
    elif args[:1] == ["ac"] and args[1:2] in (["on"], ["off"], ["real"]):
        s["ac"] = {"on": True, "off": False, "real": None}[args[1]]
    elif args[:1] == ["dry"] and args[1:2] in (["on"], ["off"]):
        s["dry"] = args[1] == "on"
    else:
        sys.exit(__doc__)
    s = {k: v for k, v in s.items() if v is not None}
    if s and (s.keys() != {"dry"} or any(m.get("name") == SIM_OUTPUT for m in hypr_json("monitors all") or [])):
        write_json(SIM, s)
    else:
        SIM.unlink(missing_ok=True)


def main():
    cmd = sys.argv[1:] or ["status"]
    if cmd[0] == "watch":
        watch()
    elif cmd[0] == "status":
        status()
    elif cmd[0] == "off":
        RUN.mkdir(parents=True, exist_ok=True)
        SUPPRESS.touch()
    elif cmd[0] == "on":
        SUPPRESS.unlink(missing_ok=True)
    elif cmd[0] == "sim":
        simulate(cmd[1:])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
