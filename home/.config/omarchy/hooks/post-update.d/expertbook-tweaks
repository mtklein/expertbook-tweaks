#!/bin/bash
repo=$(realpath "${BASH_SOURCE[0]}")
repo=${repo%/home/.config/*}

for package in hyprland sddm; do
  if [[ $(pacman -Q $package) != *.1 ]]; then
    echo "expertbook-tweaks: $package is no longer the patched build; rebuild with $repo/$package-patched/build.sh" >&2
  fi
done

packaged=$(pacman -Q voxtype-bin | awk '{print $2}')
if [[ $("$HOME/.local/bin/voxtype-patched" --version 2>/dev/null) != *" ${packaged%-*}" ]]; then
  echo "expertbook-tweaks: voxtype-patched is not version ${packaged%-*}; rebuild with $repo/voxtype-patched/build.sh" >&2
fi

